---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---
<Base title="Book a demo call — Oneward" description="Pick a time for a 30-minute call. See the agents live, in the tools your teams already use, and ask anything about the free 30-day analysis.">
  <div style="background: linear-gradient(160deg, #05071F 0%, #030FFF 100%); color: #ffffff; position: relative;">
    <div style="position: absolute; inset: 0; pointer-events: none; background-image: radial-gradient(rgba(255,255,255,0.15) 1.6px, transparent 1.6px); background-size: 48px 48px; background-position: 30px 20px; -webkit-mask-image: linear-gradient(215deg, #000 0%, rgba(0,0,0,0.45) 38%, transparent 70%); mask-image: linear-gradient(215deg, #000 0%, rgba(0,0,0,0.45) 38%, transparent 70%);"></div>
    <Nav sticky />
    <Nav />
    <div class="stub-hero library-hero" data-sticky-trigger style="position: relative; max-width: 1160px; margin: 0 auto; padding: 56px 64px 160px; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 14px;">
      <h1 style="margin: 0; font-family: 'Sora', sans-serif; font-size: clamp(32px, 3.6vw, 44px); font-weight: 600; letter-spacing: -0.025em; line-height: 1.1; max-width: 760px; text-wrap: pretty;">Book a demo call.</h1>
      <p style="margin: 0; font-size: 15px; line-height: 1.7; color: rgba(255,255,255,0.78); max-width: 600px; text-wrap: pretty;">Thirty minutes with someone who can show the agents live, in the tools your teams already use. Pick a time that suits you.</p>
    </div>
  </div>
  <section style="background: #f7f6f3; padding: 0 64px 104px;">
    <div style="max-width: 1160px; margin: -104px auto 0; position: relative;">
      <div class="demo-embed" style="background: #ffffff; border: 1px solid #e3e1db; border-radius: 14px; padding: 12px; box-shadow: 0 24px 50px rgba(2,7,31,0.25);">
        <!-- Google Calendar Appointment Scheduling -->
        <iframe
          title="Book a demo call with Oneward"
          src="https://calendar.google.com/calendar/appointments/schedules/AcZssZ1bEd8u8szmWjajGOsMk7zNeJJtUbpUer3K8dbyixL7u-72JTup49yQgVSRj_5RfjmI6AbF53Fi?gv=true"
          style="border: 0; display: block; width: 100%; height: 720px; border-radius: 8px;"
          loading="lazy"
        ></iframe>
      </div>
      <p style="margin: 18px 0 0; text-align: center; font-size: 13px; color: #6f6a5e;">Prefer email? Write to <a href="mailto:partners@getoneward.com" style="color: #030FFF;">partners@getoneward.com</a>. Or start with the <a href="/30-day-analysis" style="color: #030FFF;">free 30-day analysis</a>.</p>
    </div>
  </section>
  <Footer />
  <script src="../scripts/main.js"></script>
</Base>

---
// Placeholder pages for routes linked from the homepage until their
// real content is designed.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

export function getStaticPaths() {
  return [
    { params: { stub: '30-day-analysis' }, props: { title: '30-Day Analysis' } },
    { params: { stub: 'about' }, props: { title: 'About' } },
    { params: { stub: 'careers' }, props: { title: 'Careers' } },
    { params: { stub: 'trust-and-security' }, props: { title: 'Trust & Security' } },
    { params: { stub: 'privacy-policy' }, props: { title: 'Privacy Policy' } },
    { params: { stub: 'terms-of-service' }, props: { title: 'Terms of Service' } },
    { params: { stub: 'cookie-notice' }, props: { title: 'Cookie Notice' } },
    { params: { stub: 'impressum' }, props: { title: 'Impressum' } },
  ];
}
const { title } = Astro.props;
---
<Base title={`${title} — Oneward`}>
  <div style="background: linear-gradient(160deg, #05071F 0%, #030FFF 100%); color: #ffffff;">
    <Nav />
    <div style="max-width: 1160px; margin: 0 auto; padding: 120px 64px 160px; display: flex; flex-direction: column; gap: 16px;">
      <span style="font-family: 'IBM Plex Mono', monospace; font-size: 12px; letter-spacing: 0.18em; color: #2BD4FF;">COMING SOON</span>
      <h1 style="margin: 0; font-family: 'Sora', sans-serif; font-size: 44px; font-weight: 600; letter-spacing: -0.025em; line-height: 1.1;">{title}</h1>
      <p style="margin: 0; font-size: 15px; line-height: 1.7; color: rgba(255,255,255,0.78); max-width: 560px;">This page is on its way. In the meantime, write to <a href="mailto:partners@getoneward.com" style="color: #ffffff;">partners@getoneward.com</a>.</p>
    </div>
  </div>
  <Footer />
</Base>

    <dt>Company</dt><dd><span class="placeholder">[Oneward legal entity name and legal form, e.g. Oneward GmbH]</span></dd>
    <dt>Address</dt><dd><span class="placeholder">[Street and number]</span><br /><span class="placeholder">[Postal code, city]</span><br /><span class="placeholder">[Country]</span></dd>
    <dt>Represented by</dt><dd><span class="placeholder">[Managing director(s) / Geschäftsführer]</span></dd>

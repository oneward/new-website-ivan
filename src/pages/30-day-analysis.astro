---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import AnalysisForm from '../components/AnalysisForm.astro';

const days = Array.from({ length: 30 }, (_, i) => i + 1);
const checkIns = [7, 14, 21, 28];

const planRows = [
  ['What the AI agent does', 'The exact steps, in plain language.'],
  ['Systems involved', 'What it reads, and what it updates.'],
  ['Cases per month', 'Counted from your data.'],
  ['Time saved per month', 'Measured against your current process.'],
  ['Build effort', 'In weeks, with what we need from your team.'],
  ['Risks and controls', 'What stays read-only, and who approves.'],
  ['Return', 'What it saves, and when the saving starts.'],
  ['Recommendation', 'What to build first, and why.'],
];

const weeks = [
  { title: 'Week 1: Sign and choose.', lines: ['We sign the NDA and, if you need one, a data agreement.', 'You choose up to three use cases. We agree which data we may read.'] },
  { title: 'Weeks 2 and 3: Analyze.', lines: ['We study your data and your process for each use case.', 'We check what is possible, what it costs to build, and what it returns.'] },
  { title: 'Week 4: Documented plan.', lines: ['Day 30: the written plan for each use case, ready to use.'] },
];
const decisions = [
  'Keep the plan and stop here.',
  'Ask us to build it. We send a written offer for the scope in the plan. Our engineers build it with your team until it runs reliably and you approve it.',
  'Build it with another partner, using the plan.',
];

const fromYou = [
  { icon: '/assets/70316f42.svg', title: 'One named department contact.', body: 'For questions about data and process. About 1–2 hours per week.' },
  { icon: '/assets/4be8fc10.svg', title: 'Read-only access to the agreed data.', body: 'Only the sources for the use cases you chose.' },
  { icon: '/assets/ph-calendar-check.svg', title: 'One 30-minute check-in per week.', body: 'With the project owner.' },
];
const yourData = [
  { icon: '/assets/4be8fc10.svg', text: 'Read-only. We change nothing in your systems during the 30 days.' },
  { icon: '/assets/4df326ea.svg', text: 'Stored in the EU, in Frankfurt.' },
  { icon: '/assets/ph-archive.svg', text: 'Deleted after the 30 days, unless you decide to continue.' },
  { icon: '/assets/ph-seal-check.svg', text: 'Covered by an NDA and a data processing agreement.' },
];

const legend = [
  { shape: 'border: 1.5px solid #2BD4FF; border-radius: 2px;', text: 'Day 1: agreements signed' },
  { shape: 'background: #2BD4FF; border-radius: 50%;', text: 'Every week: one 30-minute check-in' },
  { shape: 'background: #2BD4FF; border-radius: 2px;', text: 'Day 30: your plan, ready to use' },
];

const h2 = "margin: 0; font-family: 'Sora', sans-serif; font-size: 32px; font-weight: 500; letter-spacing: -0.02em; line-height: 1.15; color: #101828; text-wrap: pretty;";
const body = 'margin: 0; font-size: 15px; line-height: 1.7; color: #4a463c; text-wrap: pretty;';
const texture = "position: absolute; inset: 0; pointer-events: none; background-image: radial-gradient(rgba(255,255,255,0.15) 1.6px, transparent 1.6px); background-size: 48px 48px; background-position: 30px 20px; -webkit-mask-image: linear-gradient(215deg, #000 0%, rgba(0,0,0,0.45) 38%, transparent 70%); mask-image: linear-gradient(215deg, #000 0%, rgba(0,0,0,0.45) 38%, transparent 70%);";
---
<Base title="Free 30-day analysis — Oneward" description="A free 30-day plan for AI agents in your HR team. We find where agents save the most time in the HR systems you already use. You keep the plan, whatever you decide next.">

  <!-- ============ Hero with request form ============ -->
  <div id="top" style="background: linear-gradient(160deg, #05071F 0%, #030FFF 100%); color: #ffffff; position: relative; overflow: hidden;">
    <div style={texture}></div>
    <Nav sticky />
    <Nav />
    <div class="two-col stub-hero library-hero" data-sticky-trigger style="position: relative; max-width: 1160px; margin: 0 auto; padding: 56px 64px 96px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 480px); gap: 64px; align-items: start;">
      <div style="display: flex; flex-direction: column; gap: 22px; padding-top: 24px;">
        <span style="font-family: 'IBM Plex Mono', monospace; font-size: 12px; letter-spacing: 0.18em; color: #2BD4FF;">FREE 30-DAY ANALYSIS</span>
        <h1 style="margin: 0; font-family: 'Sora', sans-serif; font-size: clamp(34px, 3.6vw, 46px); font-weight: 600; letter-spacing: -0.025em; line-height: 1.1; text-wrap: pretty;">A free 30-day plan for AI agents in your HR team.</h1>
        <p style="margin: 0; font-size: 16px; line-height: 1.7; color: rgba(255,255,255,0.78); max-width: 520px; text-wrap: pretty;">In 30 days we find where AI agents save the most time in your HR work, in the HR systems you already use.</p>
        <p style="margin: 0; font-size: 16px; line-height: 1.7; color: #ffffff; max-width: 520px;">You keep the plan, even if you do not continue.</p>
        <div style="display: flex; flex-direction: column; gap: 10px; margin-top: 8px;">
          {legend.map((l) => <span style="display: flex; align-items: center; gap: 10px; font-size: 14px; color: rgba(255,255,255,0.85);"><span style={`width: 10px; height: 10px; box-sizing: border-box; flex-shrink: 0; ${l.shape}`}></span>{l.text}</span>)}
        </div>
      </div>
      <div id="request"><AnalysisForm id="hero" /></div>
    </div>
  </div>

  <!-- ============ Day 30 deliverable ============ -->
  <section style="background: #ffffff; padding: 104px 64px;">
    <div class="two-col" style="max-width: 1160px; margin: 0 auto; display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: 64px; align-items: center;">
      <div style="display: flex; flex-direction: column; gap: 18px;">
        <h2 style={h2}>What you receive on Day 30.</h2>
        <p style={body}>A written plan for each use case you chose. It is built from your data and your process, not from a template.</p>
        <p style={body}>Your team can use it to decide, to budget, and to build, with us or with any other partner. It is yours to keep.</p>
      </div>
      <div style="background: #ffffff; border: 1px solid #e3e1db; border-radius: 12px; padding: 24px 26px 8px; box-shadow: 0 24px 50px rgba(2,7,31,0.08);">
        <div style="display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding-bottom: 12px; border-bottom: 1px solid #eceae4;">
          <span style="font-family: 'Sora', sans-serif; font-size: 17px; font-weight: 600; letter-spacing: -0.02em; color: #101828;">Inside each plan</span>
          <span style="font-family: 'IBM Plex Mono', monospace; font-size: 10.5px; letter-spacing: 0.14em; color: #9a968c;">FILLED FROM YOUR DATA</span>
        </div>
        {planRows.map(([k, v], i) => (
          <div style={`display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 16px; padding: 13px 0; ${i < planRows.length - 1 ? 'border-bottom: 1px solid #eceae4;' : ''}`}>
            <span style="font-size: 14px; font-weight: 600; color: #101828;">{k}</span>
            <span style="font-size: 14px; line-height: 1.5; color: #4a463c;">{v}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ How the 30 days work ============ -->
  <section style="background: #f7f6f3; background-image: radial-gradient(rgba(3,15,255,0.14) 1px, transparent 1px); background-size: 24px 24px; background-position: 12px 12px; border-top: 1px solid #e3e1db; padding: 104px 64px;">
    <div style="max-width: 1160px; margin: 0 auto; display: flex; flex-direction: column; gap: 32px;">
      <div style="display: flex; flex-direction: column; gap: 10px; max-width: 720px;">
        <h2 style={h2}>How the 30 days work.</h2>
        <p style={body}>Any HR task that follows rules and touches your systems can be a use case. Pick up to three, or start from <a href="/use-cases" style="color: #030FFF;">the agent library</a>.</p>
      </div>
      <div class="two-col" style="display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 340px); gap: 40px; align-items: start;">
        <div style="display: flex; flex-direction: column; gap: 16px;">
          <div style="background: #ffffff; border: 1px solid rgba(3,15,255,0.2); border-radius: 12px; padding: 24px 26px; display: flex; flex-direction: column; gap: 18px;">
            <span style="font-family: 'IBM Plex Mono', monospace; font-size: 11px; letter-spacing: 0.16em; color: #030FFF;">FREE</span>
            <div class="uc-grid" style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px;">
              {weeks.map((w) => (
                <div style="display: flex; flex-direction: column; gap: 10px;">
                  <span style="font-family: 'Sora', sans-serif; font-size: 15px; font-weight: 600; letter-spacing: -0.01em; color: #101828;">{w.title}</span>
                  {w.lines.map((l) => <span style="font-size: 13.5px; line-height: 1.6; color: #4a463c; text-wrap: pretty;">{l}</span>)}
                </div>
              ))}
            </div>
          </div>
          <div style="background: #ffffff; border: 1px solid #e3e1db; border-radius: 12px; padding: 24px 26px; display: flex; flex-direction: column; gap: 14px;">
            <span style="font-family: 'IBM Plex Mono', monospace; font-size: 11px; letter-spacing: 0.16em; color: #9a968c;">AFTER DAY 30 · YOUR DECISION</span>
            <ol style="margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 8px; font-size: 13.5px; line-height: 1.6; color: #4a463c;">
              {decisions.map((d) => <li>{d}</li>)}
            </ol>
          </div>
        </div>
        <div style="background: #05071F; border-radius: 12px; padding: 22px 22px 20px; display: flex; flex-direction: column; gap: 16px; box-shadow: 0 24px 50px rgba(2,7,31,0.25);">
          <div style="display: flex; align-items: center; justify-content: space-between;">
            <span style="font-family: 'IBM Plex Mono', monospace; font-size: 10.5px; letter-spacing: 0.16em; color: rgba(255,255,255,0.55);">30 DAYS</span>
            <span style="font-family: 'IBM Plex Mono', monospace; font-size: 10.5px; letter-spacing: 0.16em; color: #2BD4FF;">FREE</span>
          </div>
          <div style="display: grid; grid-template-columns: repeat(7, 1fr); gap: 6px;">
            {days.map((d) => (
              <span style={`position: relative; aspect-ratio: 1; border-radius: 6px; display: flex; align-items: flex-start; padding: 5px 0 0 6px; box-sizing: border-box; font-family: 'IBM Plex Mono', monospace; font-size: 10px; ${d === 30 ? 'background: #2BD4FF; color: #05071F; font-weight: 600;' : d === 1 ? 'border: 1px solid #2BD4FF; color: #ffffff;' : 'border: 1px solid rgba(255,255,255,0.12); color: rgba(255,255,255,0.5);'}`}>
                {String(d).padStart(2, '0')}
                {checkIns.includes(d) && <span style="position: absolute; right: 5px; bottom: 5px; width: 5px; height: 5px; border-radius: 50%; background: #2BD4FF;"></span>}
              </span>
            ))}
          </div>
          <div style="display: flex; flex-direction: column; gap: 6px; font-size: 12px; color: rgba(255,255,255,0.75);">
            {legend.map((l) => <span style="display: flex; align-items: center; gap: 8px;"><span style={`width: 9px; height: 9px; box-sizing: border-box; flex-shrink: 0; ${l.shape}`}></span>{l.text}</span>)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ What we need / your data ============ -->
  <section style="background: #ffffff; border-top: 1px solid #e3e1db; padding: 104px 64px;">
    <div style="max-width: 1160px; margin: 0 auto; display: flex; flex-direction: column; gap: 36px;">
      <h2 style={h2}>What we need from you, and how we treat your data.</h2>
      <div class="two-col" style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 48px;">
        <div style="display: flex; flex-direction: column; gap: 22px;">
          <span style="font-family: 'Sora', sans-serif; font-size: 17px; font-weight: 600; letter-spacing: -0.02em; color: #101828;">From your team</span>
          {fromYou.map((f) => (
            <div style="display: flex; align-items: flex-start; gap: 14px;">
              <span style="width: 36px; height: 36px; border-radius: 10px; background: #f7f6f3; border: 1px solid #e3e1db; display: flex; align-items: center; justify-content: center; flex-shrink: 0;"><Icon src={f.icon} size={17} color="#030FFF" /></span>
              <div style="display: flex; flex-direction: column; gap: 3px;">
                <span style="font-size: 14.5px; font-weight: 600; color: #101828;">{f.title}</span>
                <span style="font-size: 13.5px; line-height: 1.6; color: #6f6a5e;">{f.body}</span>
              </div>
            </div>
          ))}
        </div>
        <div style="display: flex; flex-direction: column; gap: 22px;">
          <span style="font-family: 'Sora', sans-serif; font-size: 17px; font-weight: 600; letter-spacing: -0.02em; color: #101828;">Your data</span>
          {yourData.map((d) => (
            <div style="display: flex; align-items: center; gap: 14px;">
              <span style="width: 36px; height: 36px; border-radius: 10px; background: #f7f6f3; border: 1px solid #e3e1db; display: flex; align-items: center; justify-content: center; flex-shrink: 0;"><Icon src={d.icon} size={17} color="#030FFF" /></span>
              <span style="font-size: 14.5px; line-height: 1.5; color: #101828;">{d.text}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Closing: form again ============ -->
  <section id="contact" style="background: linear-gradient(160deg, #030FFF 0%, #020865 100%); color: #ffffff; position: relative; overflow: hidden; padding: 104px 64px;">
    <div style={texture}></div>
    <div class="two-col" style="position: relative; max-width: 1160px; margin: 0 auto; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 480px); gap: 64px; align-items: center;">
      <div style="display: flex; flex-direction: column; gap: 18px;">
        <span style="font-family: 'IBM Plex Mono', monospace; font-size: 12px; letter-spacing: 0.18em; color: #2BD4FF;">START THE 30 DAYS</span>
        <h2 style="margin: 0; font-family: 'Sora', sans-serif; font-size: 36px; font-weight: 500; letter-spacing: -0.025em; line-height: 1.1; text-wrap: pretty;">Know where agents fit before you commit.</h2>
        <p style="margin: 0; font-size: 15px; line-height: 1.7; color: rgba(255,255,255,0.78); max-width: 460px; text-wrap: pretty;">Tell us who you are and which systems you run. We reply within one business day to set up a first call and the NDA.</p>
        <span style="font-size: 13px; color: rgba(255,255,255,0.6);">Prefer to talk first? <a href="https://calendly.com/oneward/demo" target="_blank" rel="noopener" style="color: #ffffff; text-decoration: none; border-bottom: 1px solid rgba(255,255,255,0.4);">Book a demo call</a></span>
      </div>
      <AnalysisForm id="bottom" />
    </div>
  </section>

  <Footer />
  <script src="../scripts/main.js"></script>
  <script src="../scripts/analysis-form.js"></script>
</Base>

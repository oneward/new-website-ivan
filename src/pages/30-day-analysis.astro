---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import DotMark from '../components/DotMark.astro';
import AnalysisForm from '../components/AnalysisForm.astro';

const checkIns = [7, 14, 21, 28];

const planRows = [
  ['What the AI agent does', 'The exact steps, in plain language.'],
  ['Systems involved', 'What it reads, and what it updates.'],
  ['Cases per month', 'Counted from your data.'],
  ['Time saved per month', 'Measured against your current process.'],
  ['Build effort', 'In weeks, with what we need from your team.'],
  ['Risks and controls', 'What stays read-only, and who approves.'],
  ['Return', 'What it saves, and when the saving starts.'],
  ['Recommendation', 'What to build first, and why.'],
];

const range = (a: number, b: number) => Array.from({ length: b - a + 1 }, (_, i) => a + i);
const phases = [
  { label: 'Week 1', span: 'Days 1–7', days: range(1, 7), title: 'Sign and choose.', lines: ['We sign the NDA and, if you need one, a data agreement.', 'You choose up to three use cases. We agree which data we may read.'] },
  { label: 'Weeks 2–3', span: 'Days 8–21', days: range(8, 21), title: 'Analyze.', lines: ['We study your data and your process for each use case.', 'We check what is possible, what it costs to build, and what it returns.'] },
  { label: 'Week 4', span: 'Days 22–30', days: range(22, 30), title: 'Documented plan.', lines: ['The written plan for each use case, ready to use on day 30.'] },
];
const decisions = [
  { title: 'Keep the plan and stop.', body: 'No cost, no obligation.' },
  { title: 'Ask us to build it.', body: 'We send a written offer for the scope in the plan and build it with your team.', accent: true },
  { title: 'Build it with another partner.', body: 'The plan is yours to hand over.' },
];

const fromYou = [
  { icon: '/assets/70316f42.svg', title: 'One named department contact', body: 'For questions about data and process.' },
  { icon: '/assets/4be8fc10.svg', title: 'Read-only access to the agreed data', body: 'Only the sources for the use cases you chose.' },
  { icon: '/assets/ph-calendar-check.svg', title: 'One 30-minute check-in per week', body: 'With the project owner.' },
];
const yourData = [
  { k: 'Access', v: 'Read-only. We change nothing in your systems.' },
  { k: 'Storage', v: 'EU · Frankfurt' },
  { k: 'Retention', v: 'Deleted after day 30, unless you continue' },
  { k: 'Agreements', v: 'NDA · data processing agreement' },
  { k: 'Training on your data', v: 'Never' },
];

const legend = [
  { shape: 'border: 1.5px solid #2BD4FF; border-radius: 2px;', text: 'Day 1: agreements signed' },
  { shape: 'background: #2BD4FF; border-radius: 50%;', text: 'Every week: one 30-minute check-in' },
  { shape: 'background: #2BD4FF; border-radius: 2px;', text: 'Day 30: your plan, ready to use' },
];

const h2 = "margin: 0; font-family: 'Sora', sans-serif; font-size: 32px; font-weight: 500; letter-spacing: -0.02em; line-height: 1.15; color: #101828; text-wrap: pretty;";
const body = 'margin: 0; font-size: 15px; line-height: 1.7; color: #4a463c; text-wrap: pretty;';
const mono = "font-family: 'IBM Plex Mono', monospace; font-size: 10.5px; letter-spacing: 0.16em;";
const texture = "position: absolute; inset: 0; pointer-events: none; background-image: radial-gradient(rgba(255,255,255,0.15) 1.6px, transparent 1.6px); background-size: 48px 48px; background-position: 30px 20px; -webkit-mask-image: linear-gradient(215deg, #000 0%, rgba(0,0,0,0.45) 38%, transparent 70%); mask-image: linear-gradient(215deg, #000 0%, rgba(0,0,0,0.45) 38%, transparent 70%);";
const talk = 'Prefer to talk first?';
---
<Base title="Free 30-day analysis — Oneward" description="A free 30-day plan for AI agents in your HR team. We find where agents save the most time in the HR systems you already use. You keep the plan, whatever you decide next.">

  <!-- ============ Hero with request form ============ -->
  <div id="top" style="background: linear-gradient(160deg, #05071F 0%, #030FFF 100%); color: #ffffff; position: relative;">
    <div style={texture}></div>
    <Nav sticky />
    <Nav />
    <div class="two-col stub-hero library-hero" data-sticky-trigger style="position: relative; max-width: 1160px; margin: 0 auto; padding: 56px 64px 96px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 480px); gap: 64px; align-items: start;">
      <div style="display: flex; flex-direction: column; gap: 22px; padding-top: 24px;">
        <span style="font-family: 'IBM Plex Mono', monospace; font-size: 12px; letter-spacing: 0.18em; color: #2BD4FF;">FREE 30-DAY ANALYSIS</span>
        <h1 style="margin: 0; font-family: 'Sora', sans-serif; font-size: clamp(34px, 3.6vw, 46px); font-weight: 600; letter-spacing: -0.025em; line-height: 1.1; text-wrap: pretty;">A free 30-day plan for AI agents in your HR team.</h1>
        <p style="margin: 0; font-size: 16px; line-height: 1.7; color: rgba(255,255,255,0.78); max-width: 520px; text-wrap: pretty;">In 30 days we find where AI agents save the most time in your HR work, in the HR systems you already use.</p>
        <p style="margin: 0; font-size: 16px; line-height: 1.7; color: #ffffff; max-width: 520px;">You keep the plan, even if you do not continue.</p>
        <div style="display: flex; flex-direction: column; gap: 10px; margin-top: 8px;">
          {legend.map((l) => <span style="display: flex; align-items: center; gap: 10px; font-size: 14px; color: rgba(255,255,255,0.85);"><span style={`width: 10px; height: 10px; box-sizing: border-box; flex-shrink: 0; ${l.shape}`}></span>{l.text}</span>)}
        </div>
        <span style="font-size: 13px; color: rgba(255,255,255,0.6); margin-top: 6px;">{talk} <a href="https://calendar.google.com/calendar/appointments/schedules/AcZssZ1bEd8u8szmWjajGOsMk7zNeJJtUbpUer3K8dbyixL7u-72JTup49yQgVSRj_5RfjmI6AbF53Fi?gv=true" target="_blank" rel="noopener" data-demo style="color: #ffffff; text-decoration: none; border-bottom: 1px solid rgba(255,255,255,0.4);">Book a demo call</a></span>
      </div>
      <div id="request"><AnalysisForm id="hero" /></div>
    </div>
  </div>

  <!-- ============ Day 30 deliverable ============ -->
  <section style="background: #ffffff; padding: 104px 64px;">
    <div class="two-col" style="max-width: 1160px; margin: 0 auto; display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); gap: 64px; align-items: center;">
      <div style="background: #ffffff; border: 1px solid #e3e1db; border-radius: 14px; overflow: hidden; box-shadow: 0 24px 50px rgba(2,7,31,0.10);">
        <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px 22px; background: linear-gradient(160deg, #030FFF 0%, #020865 100%); color: #ffffff;">
          <span style="display: flex; align-items: center; gap: 10px; min-width: 0;"><DotMark size={16} color="#ffffff" animation="none" /><span style="font-size: 13px; color: rgba(255,255,255,0.8); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">Example plan: <span style="color: #ffffff; font-weight: 600;">Leave and absence coordination</span></span></span>
          <span style="font-size: 12px; color: #2BD4FF; white-space: nowrap;">Delivered on day 30</span>
        </div>
        <div style="padding: 20px 22px 8px;">
          <div style="display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding-bottom: 12px; border-bottom: 1px solid #eceae4;">
            <span style="font-family: 'Sora', sans-serif; font-size: 17px; font-weight: 600; letter-spacing: -0.02em; color: #101828;">What each plan contains</span>
            <span style="font-size: 12.5px; color: #9a968c;">Filled from your data during the 30 days</span>
          </div>
          {planRows.map(([k, v], i) => (
            <div class="plan-row" style={`display: grid; grid-template-columns: 32px minmax(0, 0.85fr) minmax(0, 1.15fr); gap: 12px; align-items: baseline; padding: 12px 0; ${i < planRows.length - 1 ? 'border-bottom: 1px solid #eceae4;' : ''}`}>
              <span style="font-family: 'IBM Plex Mono', monospace; font-size: 12px; letter-spacing: 0.08em; color: #030FFF;">{String(i + 1).padStart(2, '0')}</span>
              <span style="font-size: 14px; font-weight: 600; color: #101828;">{k}</span>
              <span style="font-size: 14px; line-height: 1.5; color: #4a463c;">{v}</span>
            </div>
          ))}
        </div>
      </div>
      <div class="day30-text" style="display: flex; flex-direction: column; gap: 18px;">
        <h2 style={h2}>What you receive on Day 30.</h2>
        <p style={body}>A written plan for each use case you chose. It is built from your data and your process, not from a template.</p>
        <p style={body}>Your team can use it to decide, to budget, and to build, with us or with any other partner.</p>
        <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-top: 4px;">
          {['Built from your data', 'Not a template', 'Yours to keep'].map((t) => (
            <span style="display: flex; align-items: center; gap: 7px; font-size: 12.5px; color: #101828; background: #f7f6f3; border: 1px solid #e3e1db; border-radius: 999px; padding: 6px 12px 6px 9px; white-space: nowrap;"><Icon src="/assets/e12355da.svg" size={13} color="#030FFF" />{t}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ How the 30 days work ============ -->
  <section style="background: #f7f6f3; background-image: radial-gradient(rgba(3,15,255,0.14) 1px, transparent 1px); background-size: 24px 24px; background-position: 12px 12px; border-top: 1px solid #e3e1db; padding: 104px 64px;">
    <div style="max-width: 1160px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 40px;">
      <div style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 14px; max-width: 680px;">
        <h2 style={h2}>How the 30 days work.</h2>
        <p style={body}>Any HR task that follows rules and touches your systems can be a use case. Pick up to three, or start from <a href="/use-cases" style="color: #030FFF;">the agent library</a>. The 30 days are free; what happens after is your decision.</p>
      </div>

      <div class="tl-card" style="width: 100%; max-width: 720px; box-sizing: border-box; background: #ffffff; border: 1px solid #e3e1db; border-radius: 14px; padding: 30px 32px 26px; box-shadow: 0 24px 50px rgba(2,7,31,0.06); display: flex; flex-direction: column;">
        {phases.map((ph, i) => (
          <div style={`display: grid; grid-template-columns: 18px 12px minmax(0, 1fr); column-gap: 10px; ${i < phases.length - 1 ? 'padding-bottom: 16px;' : ''}`}>
            <div style="position: relative;">
              <span style="position: absolute; top: 0; left: 0; font-family: 'IBM Plex Mono', monospace; font-size: 10.5px; color: #9a968c; line-height: 12px;">{ph.days[0]}</span>
              {i === phases.length - 1 && <span style="position: absolute; bottom: 0; left: 0; font-family: 'IBM Plex Mono', monospace; font-size: 10.5px; color: #030FFF; line-height: 12px;">30</span>}
            </div>
            <div style="display: flex; flex-direction: column; gap: 3px;">
              {ph.days.map((d) => (
                <span title={`Day ${d}`} style={`height: 12px; border-radius: 3px; box-sizing: border-box; ${d === 30 ? 'background: #2BD4FF;' : d === 1 ? 'border: 1.5px solid #030FFF; background: #ffffff;' : checkIns.includes(d) ? 'background: #030FFF;' : 'background: rgba(3,15,255,0.14);'}`}></span>
              ))}
            </div>
            <div style={`display: flex; flex-direction: column; gap: 5px; min-height: ${ph.days.length * 15 - 3}px; padding-left: 8px;`}>
              <div style="display: flex; align-items: baseline; gap: 10px; line-height: 12px;">
                <span style="font-size: 12.5px; font-weight: 600; color: #030FFF;">{ph.label}</span>
                <span style="font-size: 12px; color: #9a968c;">{ph.span}</span>
              </div>
              <span style="font-family: 'Sora', sans-serif; font-size: 17px; font-weight: 600; letter-spacing: -0.01em; color: #101828; margin-top: 2px;">{ph.title}</span>
              <div style="display: flex; flex-direction: column; gap: 3px; margin-top: 2px;">
                {ph.lines.map((l) => <span style="font-size: 14px; line-height: 1.55; color: #4a463c; text-wrap: pretty; max-width: 520px;">{l}</span>)}
              </div>
            </div>
          </div>
        ))}
        <div style="display: grid; grid-template-columns: 18px 12px minmax(0, 1fr); column-gap: 10px; margin-top: 18px;">
          <div></div>
          <div style="grid-column: 2 / 4; display: flex; align-items: center; gap: 18px; flex-wrap: wrap;">
            <span style="display: flex; align-items: center; gap: 8px; font-size: 12.5px; color: #6f6a5e;"><span style="width: 12px; height: 12px; border-radius: 3px; border: 1.5px solid #030FFF; box-sizing: border-box;"></span>Day 1: agreements signed</span>
            <span style="display: flex; align-items: center; gap: 8px; font-size: 12.5px; color: #6f6a5e;"><span style="width: 12px; height: 12px; border-radius: 3px; background: #030FFF;"></span>Weekly 30-minute check-in</span>
            <span style="display: flex; align-items: center; gap: 8px; font-size: 12.5px; color: #6f6a5e;"><span style="width: 12px; height: 12px; border-radius: 3px; background: #2BD4FF;"></span>Day 30: your plan, ready to use</span>
          </div>
        </div>

        <div style="margin-top: 26px; padding-top: 24px; border-top: 1px solid #eceae4; display: flex; flex-direction: column; gap: 16px;">
          <span style="font-family: 'Sora', sans-serif; font-size: 17px; font-weight: 600; letter-spacing: -0.01em; color: #101828;">After day 30, you decide.</span>
          <div style="display: flex; flex-direction: column; gap: 12px; max-width: 560px;">
            {decisions.map((d) => (
              <div style="display: grid; grid-template-columns: 16px minmax(0, 1fr); column-gap: 10px; align-items: start;">
                {d.accent
                  ? <span style="margin-top: 3px;"><DotMark size={16} /></span>
                  : <span style="display: flex; justify-content: center; margin-top: 7px;"><span style="width: 7px; height: 7px; border-radius: 50%; background: #030FFF;"></span></span>}
                {d.accent
                  ? <span style="display: flex; flex-direction: column; gap: 3px; font-size: 14px; line-height: 1.55; color: #4a463c;"><span style="font-weight: 600; color: #101828;">{d.title}</span><span>{d.body}</span></span>
                  : <span style="font-size: 14px; line-height: 1.55; color: #4a463c;"><span style="font-weight: 600; color: #101828;">{d.title}</span> {d.body}</span>}
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ What we need / your data ============ -->
  <section style="background: #ffffff; border-top: 1px solid #e3e1db; padding: 104px 64px;">
    <div style="max-width: 1160px; margin: 0 auto; display: flex; flex-direction: column; gap: 36px;">
      <div style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 14px; max-width: 980px; margin: 0 auto;">
        <h2 style={h2}>What we need from you, and how we treat your data.</h2>
      </div>
      <div class="two-col" style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; align-items: stretch;">
        <div style="background: #f7f6f3; border: 1px solid #e3e1db; border-radius: 14px; padding: 26px 28px; display: flex; flex-direction: column; gap: 22px;">
          <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;">
            <span style="font-family: 'Sora', sans-serif; font-size: 17px; font-weight: 600; letter-spacing: -0.02em; color: #101828;">From your team</span>
            <span style="font-size: 12px; color: #030FFF; background: rgba(3,15,255,0.06); border: 1px solid rgba(3,15,255,0.2); border-radius: 999px; padding: 4px 10px; white-space: nowrap;">About 1–2 hours per week</span>
          </div>
          <div style="display: flex; flex-direction: column; gap: 18px;">
            {fromYou.map((f) => (
              <div style="display: flex; align-items: flex-start; gap: 14px;">
                <span style="width: 38px; height: 38px; border-radius: 10px; background: #ffffff; border: 1px solid #e3e1db; display: flex; align-items: center; justify-content: center; flex-shrink: 0;"><Icon src={f.icon} size={17} color="#030FFF" /></span>
                <div style="display: flex; flex-direction: column; gap: 3px;">
                  <span style="font-size: 14.5px; font-weight: 600; color: #101828;">{f.title}</span>
                  <span style="font-size: 13.5px; line-height: 1.6; color: #6f6a5e;">{f.body}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
        <div style="background: #101828; border-radius: 14px; overflow: hidden; display: flex; flex-direction: column; box-shadow: 0 24px 50px rgba(2,7,31,0.25);">
          <div style="padding: 22px 26px 18px; display: flex; flex-direction: column; gap: 14px; flex: 1;">
            <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;">
              <span style="display: flex; align-items: center; gap: 10px;"><DotMark size={18} color="#ffffff" animation="none" /><span style={`${mono} color: rgba(255,255,255,0.6);`}>YOUR DATA · 30 DAYS</span></span>
              <span style="display: flex; align-items: center; gap: 8px;"><span style="width: 7px; height: 7px; border-radius: 50%; background: #16DB4E; animation: owLive 2.2s ease-in-out infinite;"></span><span style="font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: #16DB4E;">READ-ONLY</span></span>
            </div>
            <div style="height: 1px; background: rgba(255,255,255,0.12);"></div>
            {yourData.map((row) => (
              <div style="display: flex; align-items: baseline; justify-content: space-between; gap: 16px;"><span style="font-size: 13px; color: rgba(255,255,255,0.7); white-space: nowrap;">{row.k}</span><span style="font-family: 'IBM Plex Mono', monospace; font-size: 12px; color: #ffffff; text-align: right; line-height: 1.5;">{row.v}</span></div>
            ))}
          </div>
          <div style="background: #0b1224; border-top: 1px solid rgba(255,255,255,0.08); padding: 14px 26px; display: flex; align-items: center; gap: 10px;">
            <Icon src="/assets/ph-seal-check.svg" size={14} color="#2BD4FF" />
            <span style="font-size: 12.5px; line-height: 1.5; color: rgba(255,255,255,0.75);">Covered by an NDA and a data processing agreement before anything is shared.</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Closing: form again ============ -->
  <section id="contact" style="background: linear-gradient(160deg, #030FFF 0%, #020865 100%); color: #ffffff; position: relative; padding: 104px 64px;">
    <div style={texture}></div>
    <div class="two-col" style="position: relative; max-width: 1160px; margin: 0 auto; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 480px); gap: 64px; align-items: center;">
      <div style="display: flex; flex-direction: column; gap: 18px;">
        <h2 style="margin: 0; font-family: 'Sora', sans-serif; font-size: 36px; font-weight: 500; letter-spacing: -0.025em; line-height: 1.1; text-wrap: pretty;">Know where agents fit before you commit.</h2>
        <p style="margin: 0; font-size: 15px; line-height: 1.7; color: rgba(255,255,255,0.78); max-width: 460px; text-wrap: pretty;">Tell us who you are and which systems you run. We reply within one business day to set up a first call and the NDA.</p>
        <span style="font-size: 13px; color: rgba(255,255,255,0.6);">{talk} <a href="https://calendar.google.com/calendar/appointments/schedules/AcZssZ1bEd8u8szmWjajGOsMk7zNeJJtUbpUer3K8dbyixL7u-72JTup49yQgVSRj_5RfjmI6AbF53Fi?gv=true" target="_blank" rel="noopener" data-demo style="color: #ffffff; text-decoration: none; border-bottom: 1px solid rgba(255,255,255,0.4);">Book a demo call</a></span>
      </div>
      <AnalysisForm id="bottom" />
    </div>
  </section>

  <Footer />
  <script src="../scripts/main.js"></script>
  <script src="../scripts/analysis-form.js"></script>
</Base>

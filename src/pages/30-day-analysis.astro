---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import DotMark from '../components/DotMark.astro';
import Icon from '../components/Icon.astro';
import { hrisOptions, hrToolGroups } from '../data/hrSystems';

const days = Array.from({ length: 30 }, (_, i) => i + 1);
const checkIns = [7, 14, 21, 28];

const steps = [
  { icon: '/assets/ph-file-text.svg', title: 'Reads the case' },
  { icon: '/assets/ph-clipboard-text.svg', title: 'Follows your rules' },
  { icon: '/assets/ph-database.svg', title: 'Updates your systems' },
];

const planRows = [
  ['What the AI agent does', 'The exact steps, in plain language.'],
  ['Systems involved', 'What it reads, and what it updates.'],
  ['Cases per month', 'Counted from your data.'],
  ['Time saved per month', 'Measured against your current process.'],
  ['Build effort', 'In weeks, with what we need from your team.'],
  ['Risks and controls', 'What stays read-only, and who approves.'],
  ['Return', 'What it saves, and when the saving starts.'],
  ['Recommendation', 'What to build first, and why.'],
];

const examples = [
  { n: '01', tag: 'Payroll', title: 'Check every payslip before payday.', body: 'Finds errors before employees see them.' },
  { n: '02', tag: 'Joiners, movers, leavers', title: 'Close every account on the last working day.', body: 'No open access after someone leaves.' },
  { n: '03', tag: 'HR helpdesk', title: "Answer employees' HR questions.", body: 'Answers from your policies, in the tools you use.' },
  { n: '04', tag: 'Any HR task', title: 'Your choice.', body: 'We have already mapped more than 30.', open: true },
];
const areas = ['Core HR and records', 'Recruiting', 'Onboarding and offboarding', 'Time and absence', 'Benefits', 'Performance', 'Compensation', 'Learning', 'Compliance', 'Workforce planning'];

const weeks = [
  { title: 'Week 1: Sign and choose.', lines: ['We sign the NDA and, if you need one, a data agreement.', 'You choose up to three use cases. We agree which data we may read.'] },
  { title: 'Weeks 2 and 3: Analyze.', lines: ['We study your data and your process for each use case.', 'We check what is possible, what it costs to build, and what it returns.'] },
  { title: 'Week 4: Documented plan.', lines: ['Day 30: the written plan for each use case, ready to use.'] },
];
const decisions = [
  'Keep the plan and stop here.',
  'Ask us to build it. We send a written offer for the scope in the plan. Our engineers build it with your team until it runs reliably and you approve it.',
  'Build it with another partner, using the plan.',
];

const fromYou = [
  { icon: '/assets/70316f42.svg', title: 'One named department contact.', body: 'For questions about data and process. About 1–2 hours per week.' },
  { icon: '/assets/4be8fc10.svg', title: 'Read-only access to the agreed data.', body: 'Only the sources for the use cases you chose.' },
  { icon: '/assets/ph-calendar-check.svg', title: 'One 30-minute check-in per week.', body: 'With the project owner.' },
];
const yourData = [
  { icon: '/assets/4be8fc10.svg', text: 'Read-only. We change nothing in your systems during the 30 days.' },
  { icon: '/assets/4df326ea.svg', text: 'Stored in the EU, in Frankfurt.' },
  { icon: '/assets/ph-archive.svg', text: 'Deleted after the 30 days, unless you decide to continue.' },
  { icon: '/assets/ph-seal-check.svg', text: 'Covered by an NDA and a data processing agreement.' },
];

const h2 = "margin: 0; font-family: 'Sora', sans-serif; font-size: 32px; font-weight: 500; letter-spacing: -0.02em; line-height: 1.15; color: #101828; text-wrap: pretty;";
const body = 'margin: 0; font-size: 15px; line-height: 1.7; color: #4a463c; text-wrap: pretty;';
const mono = "font-family: 'IBM Plex Mono', monospace; font-size: 11px; letter-spacing: 0.16em; color: #030FFF;";
---
<Base title="Free 30-day analysis — Oneward" description="A free 30-day plan for AI agents in your HR team. We find where agents save the most time in the HR systems you already use. You keep the plan, whatever you decide next.">

  <!-- ============ Hero with request form ============ -->
  <div id="top" style="background: linear-gradient(160deg, #05071F 0%, #030FFF 100%); color: #ffffff; position: relative; overflow: hidden;">
    <div style="position: absolute; inset: 0; pointer-events: none; background-image: radial-gradient(rgba(255,255,255,0.15) 1.6px, transparent 1.6px); background-size: 48px 48px; background-position: 30px 20px; -webkit-mask-image: linear-gradient(215deg, #000 0%, rgba(0,0,0,0.45) 38%, transparent 70%); mask-image: linear-gradient(215deg, #000 0%, rgba(0,0,0,0.45) 38%, transparent 70%);"></div>
    <Nav sticky />
    <Nav />
    <div class="two-col stub-hero library-hero" data-sticky-trigger style="position: relative; max-width: 1160px; margin: 0 auto; padding: 56px 64px 96px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 480px); gap: 64px; align-items: start;">
      <div style="display: flex; flex-direction: column; gap: 22px; padding-top: 24px;">
        <span style="font-family: 'IBM Plex Mono', monospace; font-size: 12px; letter-spacing: 0.18em; color: #2BD4FF;">FREE 30-DAY ANALYSIS</span>
        <h1 style="margin: 0; font-family: 'Sora', sans-serif; font-size: clamp(34px, 3.6vw, 46px); font-weight: 600; letter-spacing: -0.025em; line-height: 1.1; text-wrap: pretty;">A free 30-day plan for AI agents in your HR team.</h1>
        <p style="margin: 0; font-size: 16px; line-height: 1.7; color: rgba(255,255,255,0.78); max-width: 520px; text-wrap: pretty;">In 30 days we find where AI agents save the most time in your HR work, in the HR systems you already use.</p>
        <p style="margin: 0; font-size: 16px; line-height: 1.7; color: #ffffff; max-width: 520px;">You keep the plan, even if you do not continue.</p>
        <div style="display: flex; flex-direction: column; gap: 10px; margin-top: 8px;">
          <span style="display: flex; align-items: center; gap: 10px; font-size: 14px; color: rgba(255,255,255,0.85);"><span style="width: 10px; height: 10px; border-radius: 2px; border: 1.5px solid #2BD4FF; box-sizing: border-box; flex-shrink: 0;"></span>Day 1: agreements signed</span>
          <span style="display: flex; align-items: center; gap: 10px; font-size: 14px; color: rgba(255,255,255,0.85);"><span style="width: 10px; height: 10px; border-radius: 50%; background: #2BD4FF; flex-shrink: 0;"></span>Every week: one 30-minute check-in</span>
          <span style="display: flex; align-items: center; gap: 10px; font-size: 14px; color: rgba(255,255,255,0.85);"><span style="width: 10px; height: 10px; border-radius: 2px; background: #2BD4FF; flex-shrink: 0;"></span>Day 30: your plan, ready to use</span>
        </div>
      </div>

      <div id="request" style="background: #ffffff; color: #101828; border-radius: 14px; padding: 28px 28px 26px; box-shadow: 0 24px 50px rgba(2,7,31,0.45);">
        <form data-analysis-form novalidate style="display: flex; flex-direction: column; gap: 18px;">
          <div style="display: flex; flex-direction: column; gap: 4px;">
            <span style="font-family: 'Sora', sans-serif; font-size: 18px; font-weight: 600; letter-spacing: -0.02em;">Request your free analysis</span>
            <span style="font-size: 13px; color: #6f6a5e;">We reply within one business day to set up a first call.</span>
          </div>
          <div class="form-grid">
            <div class="field"><label for="f-name">Name <span class="req">*</span></label><input id="f-name" name="name" type="text" autocomplete="name" required placeholder="Your name" /></div>
            <div class="field"><label for="f-email">Work email <span class="req">*</span></label><input id="f-email" name="email" type="email" autocomplete="email" required placeholder="you@company.com" /></div>
            <div class="field"><label for="f-company">Company</label><input id="f-company" name="company" type="text" autocomplete="organization" placeholder="Company name" /></div>
            <div class="field"><label for="f-location">Location</label><input id="f-location" name="location" type="text" autocomplete="country-name" placeholder="City or country" /></div>
            <div class="field wide"><label for="f-website">Company website</label><input id="f-website" name="website" type="url" autocomplete="url" placeholder="https://" /></div>
            <div class="field"><label for="f-hris">Current HRIS</label><select id="f-hris" name="hris"><option value="" selected>Select…</option>{hrisOptions.map((o) => <option value={o}>{o}</option>)}</select></div>
            <div class="field"><label for="f-tools">Other HR tools</label><select id="f-tools" name="tools"><option value="" selected>Select…</option>{hrToolGroups.map((g) => <optgroup label={g.label}>{g.options.map((o) => <option value={o}>{o}</option>)}</optgroup>)}<option value="Several of the above">Several of the above</option><option value="Other">Other</option><option value="None">None</option></select></div>
          </div>
          <button type="submit" class="btn-blue" style="border: 0; cursor: pointer; font-size: 15px; padding: 14px 24px; width: 100%;">Request my free analysis</button>
          <p data-analysis-error hidden style="margin: 0; font-size: 13px; color: #d9463e;">Something went wrong sending the request. Please email <a href="mailto:partners@getoneward.com" style="color: #d9463e;">partners@getoneward.com</a> instead.</p>
          <p style="margin: 0; font-size: 12px; line-height: 1.6; color: #9a968c; text-align: center;">Free, no commitment. Nothing is shared before an NDA is signed.</p>
        </form>
        <div data-analysis-done hidden style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 12px; padding: 24px 0 16px;">
          <DotMark size={44} />
          <span style="font-family: 'Sora', sans-serif; font-size: 18px; font-weight: 600; letter-spacing: -0.02em;">Thank you.</span>
          <span style="font-size: 14px; line-height: 1.6; color: #4a463c; max-width: 320px;">We will reply within one business day to set up a first call and the NDA.</span>
        </div>
      </div>
    </div>
  </div>

  <!-- ============ What an agent is ============ -->
  <section style="background: #ffffff; padding: 104px 64px;">
    <div class="two-col" style="max-width: 1160px; margin: 0 auto; display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 64px; align-items: center;">
      <div style="display: flex; flex-direction: column; gap: 18px;">
        <h2 style={h2}>Routine HR work can now run on its own.</h2>
        <p style={body}>An AI agent is software that completes a task from start to finish. It reads the case, follows your rules, and updates your systems.</p>
        <p style={body}>This works today, on top of the HR systems you already have. The open question is where it saves the most time in your team, and how fast.</p>
        <p style={body}>The 30-day analysis answers that question with your data and workflows.</p>
      </div>
      <div style="display: flex; flex-direction: column; gap: 16px;">
        <div class="uc-grid" style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; align-items: stretch;">
          {steps.map((s, i) => (
            <div style="display: flex; align-items: stretch; min-width: 0;">
              <div style="flex: 1; background: #ffffff; border: 1px solid #e3e1db; border-radius: 12px; padding: 20px 18px 18px; display: flex; flex-direction: column; gap: 22px; min-width: 0;">
                <span style="width: 36px; height: 36px; border-radius: 10px; background: rgba(3,15,255,0.06); display: flex; align-items: center; justify-content: center;"><Icon src={s.icon} size={18} color="#030FFF" /></span>
                <span style="font-family: 'Sora', sans-serif; font-size: 15px; font-weight: 500; letter-spacing: -0.01em; color: #101828;">{s.title}</span>
              </div>
              {i < steps.length - 1 && <span class="strip-link" style="width: 16px; flex-shrink: 0; align-self: center; border-top: 2px dotted rgba(3,15,255,0.35);"></span>}
            </div>
          ))}
        </div>
        <div style="border-top: 1px solid #eceae4; padding-top: 12px; font-size: 13px; color: #6f6a5e;">Example: a payslip with a wrong tax code is flagged before payday.</div>
      </div>
    </div>
  </section>

  <!-- ============ Day 30 deliverable ============ -->
  <section style="background: #f7f6f3; background-image: radial-gradient(rgba(3,15,255,0.14) 1px, transparent 1px); background-size: 24px 24px; background-position: 12px 12px; border-top: 1px solid #e3e1db; padding: 104px 64px;">
    <div class="two-col" style="max-width: 1160px; margin: 0 auto; display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: 64px; align-items: center;">
      <div style="display: flex; flex-direction: column; gap: 18px;">
        <h2 style={h2}>What you receive on Day 30.</h2>
        <p style={body}>A written plan for each use case you chose. It is built from your data and your process, not from a template.</p>
        <p style={body}>Your team can use it to decide, to budget, and to build, with us or with any other partner. It is yours to keep.</p>
      </div>
      <div style="background: #ffffff; border: 1px solid #e3e1db; border-radius: 12px; padding: 24px 26px 8px; box-shadow: 0 24px 50px rgba(2,7,31,0.08);">
        <div style="display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding-bottom: 12px; border-bottom: 1px solid #eceae4;">
          <span style="font-family: 'Sora', sans-serif; font-size: 17px; font-weight: 600; letter-spacing: -0.02em; color: #101828;">Inside each plan</span>
          <span style="font-family: 'IBM Plex Mono', monospace; font-size: 10.5px; letter-spacing: 0.14em; color: #9a968c;">FILLED FROM YOUR DATA</span>
        </div>
        {planRows.map(([k, v], i) => (
          <div class="plan-row" style={`display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 16px; padding: 13px 0; ${i < planRows.length - 1 ? 'border-bottom: 1px solid #eceae4;' : ''}`}>
            <span style="font-size: 14px; font-weight: 600; color: #101828;">{k}</span>
            <span style="font-size: 14px; line-height: 1.5; color: #4a463c;">{v}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ Use cases ============ -->
  <section style="background: #ffffff; border-top: 1px solid #e3e1db; padding: 104px 64px;">
    <div style="max-width: 1160px; margin: 0 auto; display: flex; flex-direction: column; gap: 28px;">
      <div style="display: flex; flex-direction: column; gap: 10px; max-width: 760px;">
        <h2 style={h2}>You choose up to three use cases.</h2>
        <p style={body}>Any HR task that follows rules and touches your systems can be a use case. Three examples, and one open place for your choice.</p>
      </div>
      <div class="problem-grid" style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px;">
        {examples.map((x) => (
          <div style={`background: ${x.open ? '#f7f6f3' : '#ffffff'}; border: 1px ${x.open ? 'dashed #c9c5ba' : 'solid #e3e1db'}; border-radius: 12px; padding: 22px 24px; display: flex; flex-direction: column; gap: 14px;`}>
            <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px;">
              <span style={mono}>{x.n}</span>
              <span style="font-size: 12px; color: #030FFF; background: rgba(3,15,255,0.06); border-radius: 999px; padding: 4px 10px; white-space: nowrap;">{x.tag}</span>
            </div>
            <span style="font-family: 'Sora', sans-serif; font-size: 19px; font-weight: 500; letter-spacing: -0.02em; color: #101828; text-wrap: pretty;">{x.title}</span>
            <span style="font-size: 14px; line-height: 1.6; color: #4a463c;">{x.body}</span>
          </div>
        ))}
      </div>
      <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
        <span style="font-size: 13px; color: #6f6a5e; margin-right: 4px;">Other areas</span>
        {areas.map((a) => <span style="font-size: 12.5px; color: #4a463c; background: #ffffff; border: 1px solid #e3e1db; border-radius: 999px; padding: 6px 12px; white-space: nowrap;">{a}</span>)}
        <a href="/use-cases" style="font-size: 13px; color: #030FFF; text-decoration: none; margin-left: 4px; white-space: nowrap;">See the agent library →</a>
      </div>
    </div>
  </section>

  <!-- ============ How the 30 days work ============ -->
  <section style="background: #f7f6f3; border-top: 1px solid #e3e1db; padding: 104px 64px;">
    <div style="max-width: 1160px; margin: 0 auto; display: flex; flex-direction: column; gap: 32px;">
      <h2 style={h2}>How the 30 days work.</h2>
      <div class="two-col" style="display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 340px); gap: 40px; align-items: start;">
        <div style="display: flex; flex-direction: column; gap: 16px;">
          <div style="background: #ffffff; border: 1px solid rgba(3,15,255,0.2); border-radius: 12px; padding: 24px 26px; display: flex; flex-direction: column; gap: 18px;">
            <span style={mono}>FREE</span>
            <div class="uc-grid" style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px;">
              {weeks.map((w) => (
                <div style="display: flex; flex-direction: column; gap: 10px;">
                  <span style="font-family: 'Sora', sans-serif; font-size: 15px; font-weight: 600; letter-spacing: -0.01em; color: #101828;">{w.title}</span>
                  {w.lines.map((l) => <span style="font-size: 13.5px; line-height: 1.6; color: #4a463c; text-wrap: pretty;">{l}</span>)}
                </div>
              ))}
            </div>
          </div>
          <div style="background: #ffffff; border: 1px solid #e3e1db; border-radius: 12px; padding: 24px 26px; display: flex; flex-direction: column; gap: 14px;">
            <span style="font-family: 'IBM Plex Mono', monospace; font-size: 11px; letter-spacing: 0.16em; color: #9a968c;">AFTER DAY 30 · YOUR DECISION</span>
            <ol style="margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 8px; font-size: 13.5px; line-height: 1.6; color: #4a463c;">
              {decisions.map((d) => <li>{d}</li>)}
            </ol>
          </div>
        </div>
        <div style="background: #05071F; border-radius: 12px; padding: 22px 22px 20px; display: flex; flex-direction: column; gap: 16px; box-shadow: 0 24px 50px rgba(2,7,31,0.25);">
          <div style="display: flex; align-items: center; justify-content: space-between;">
            <span style="font-family: 'IBM Plex Mono', monospace; font-size: 10.5px; letter-spacing: 0.16em; color: rgba(255,255,255,0.55);">30 DAYS</span>
            <span style="font-family: 'IBM Plex Mono', monospace; font-size: 10.5px; letter-spacing: 0.16em; color: #2BD4FF;">FREE</span>
          </div>
          <div style="display: grid; grid-template-columns: repeat(7, 1fr); gap: 6px;">
            {days.map((d) => (
              <span style={`position: relative; aspect-ratio: 1; border-radius: 6px; display: flex; align-items: flex-start; padding: 5px 0 0 6px; box-sizing: border-box; font-family: 'IBM Plex Mono', monospace; font-size: 10px; ${d === 30 ? 'background: #2BD4FF; color: #05071F; font-weight: 600;' : d === 1 ? 'border: 1px solid #2BD4FF; color: #ffffff;' : 'border: 1px solid rgba(255,255,255,0.12); color: rgba(255,255,255,0.5);'}`}>
                {String(d).padStart(2, '0')}
                {checkIns.includes(d) && <span style="position: absolute; right: 5px; bottom: 5px; width: 5px; height: 5px; border-radius: 50%; background: #2BD4FF;"></span>}
              </span>
            ))}
          </div>
          <div style="display: flex; flex-direction: column; gap: 6px; font-size: 12px; color: rgba(255,255,255,0.75);">
            <span style="display: flex; align-items: center; gap: 8px;"><span style="width: 9px; height: 9px; border-radius: 2px; border: 1.5px solid #2BD4FF; box-sizing: border-box;"></span>Day 1: agreements signed</span>
            <span style="display: flex; align-items: center; gap: 8px;"><span style="width: 9px; height: 9px; border-radius: 50%; background: #2BD4FF;"></span>Every week: one 30-minute check-in</span>
            <span style="display: flex; align-items: center; gap: 8px;"><span style="width: 9px; height: 9px; border-radius: 2px; background: #2BD4FF;"></span>Day 30: your plan, ready to use</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ What we need / your data ============ -->
  <section style="background: #ffffff; border-top: 1px solid #e3e1db; padding: 104px 64px;">
    <div style="max-width: 1160px; margin: 0 auto; display: flex; flex-direction: column; gap: 36px;">
      <h2 style={h2}>What we need from you, and how we treat your data.</h2>
      <div class="two-col" style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 48px;">
        <div style="display: flex; flex-direction: column; gap: 22px;">
          <span style="font-family: 'Sora', sans-serif; font-size: 17px; font-weight: 600; letter-spacing: -0.02em; color: #101828;">From your team</span>
          {fromYou.map((f) => (
            <div style="display: flex; align-items: flex-start; gap: 14px;">
              <span style="width: 36px; height: 36px; border-radius: 10px; background: #f7f6f3; border: 1px solid #e3e1db; display: flex; align-items: center; justify-content: center; flex-shrink: 0;"><Icon src={f.icon} size={17} color="#030FFF" /></span>
              <div style="display: flex; flex-direction: column; gap: 3px;">
                <span style="font-size: 14.5px; font-weight: 600; color: #101828;">{f.title}</span>
                <span style="font-size: 13.5px; line-height: 1.6; color: #6f6a5e;">{f.body}</span>
              </div>
            </div>
          ))}
        </div>
        <div style="display: flex; flex-direction: column; gap: 22px;">
          <span style="font-family: 'Sora', sans-serif; font-size: 17px; font-weight: 600; letter-spacing: -0.02em; color: #101828;">Your data</span>
          {yourData.map((d) => (
            <div style="display: flex; align-items: center; gap: 14px;">
              <span style="width: 36px; height: 36px; border-radius: 10px; background: #f7f6f3; border: 1px solid #e3e1db; display: flex; align-items: center; justify-content: center; flex-shrink: 0;"><Icon src={d.icon} size={17} color="#030FFF" /></span>
              <span style="font-size: 14.5px; line-height: 1.5; color: #101828;">{d.text}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Closing CTA ============ -->
  <section style="background: linear-gradient(160deg, #030FFF 0%, #020865 100%); padding: 96px 64px; position: relative; overflow: hidden; color: #ffffff;">
    <div style="position: absolute; inset: 0; pointer-events: none; background-image: radial-gradient(rgba(255,255,255,0.15) 1.6px, transparent 1.6px); background-size: 48px 48px; background-position: 30px 20px; -webkit-mask-image: linear-gradient(215deg, #000 0%, rgba(0,0,0,0.45) 38%, transparent 70%); mask-image: linear-gradient(215deg, #000 0%, rgba(0,0,0,0.45) 38%, transparent 70%);"></div>
    <div style="position: relative; display: flex; flex-direction: column; align-items: center; gap: 24px; text-align: center;">
      <DotMark size={56} color="#ffffff" animation="pulse" />
      <h2 style="margin: 0; font-family: 'Sora', sans-serif; font-size: 36px; font-weight: 500; letter-spacing: -0.025em; line-height: 1.1; max-width: 700px; text-wrap: pretty;">Thirty days. A plan you keep.</h2>
      <div style="display: flex; align-items: center; justify-content: center; gap: 14px; flex-wrap: wrap;">
        <a href="#request" class="btn-primary" style="font-size: 15px; padding: 14px 30px;">Request your free analysis</a>
        <a href="https://calendly.com/oneward/demo" target="_blank" rel="noopener" class="btn-ghost" style="font-size: 15px; padding: 13px 28px;">Book a demo call</a>
      </div>
    </div>

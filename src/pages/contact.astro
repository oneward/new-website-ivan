---
import PageShell from '../layouts/PageShell.astro';
import Icon from '../components/Icon.astro';
import DotMark from '../components/DotMark.astro';

const demoUrl = 'https://calendar.google.com/calendar/appointments/schedules/AcZssZ1bEd8u8szmWjajGOsMk7zNeJJtUbpUer3K8dbyixL7u-72JTup49yQgVSRj_5RfjmI6AbF53Fi?gv=true';

const ways = [
  { icon: '/assets/ph-clipboard-text.svg', title: 'Start the free 30-day analysis', body: 'Tell us who you are and which systems you run. We reply within one business day to set up a first call and the NDA.', href: '/30-day-analysis', link: 'Request the analysis' },
  { icon: '/assets/ph-calendar-check.svg', title: 'Book a demo call', body: 'Thirty minutes with our team. See agents running in a tenant and bring the questions your security team will ask.', href: demoUrl, link: 'Pick a time', demo: true },
  { icon: '/assets/ph-chat-circle.svg', title: 'Email us', body: 'For everything else: partnerships, press, security questionnaires, or a question that does not fit a form.', href: 'mailto:partners@getoneward.com', link: 'partners@getoneward.com' },
];

const details = [
  ['Company', 'Oneward, Inc.', '/impressum'],
  ['Privacy requests', 'privacy@getoneward.com', 'mailto:privacy@getoneward.com'],
  ['Security documentation', 'Trust & Security', '/trust-and-security'],
  ['LinkedIn', 'linkedin.com/company/oneward', 'https://www.linkedin.com/company/oneward/'],
];

const next = [
  { title: 'We reply within one business day.', body: 'A person, not an autoresponder. If it is a security questionnaire or a privacy request, the reply comes from the people who own it.' },
  { title: 'A first call, thirty minutes.', body: 'What you run, what slows your team down, and whether agents are a fit. If they are not, we say so.' },
  { title: 'NDA before anything is shared.', body: 'Nothing about your systems or data changes hands until the agreements are signed. Then the analysis can start.' },
];

const h2 = "margin: 0; font-family: 'Sora', sans-serif; font-size: 32px; font-weight: 500; letter-spacing: -0.02em; line-height: 1.15; color: #101828; text-wrap: pretty;";
const body = 'margin: 0; font-size: 15px; line-height: 1.7; color: #4a463c; text-wrap: pretty;';
---
<PageShell
  title="Talk to us."
  intro="One inbox, one calendar, and one form. Pick whichever is fastest for you; every route reaches the same people, and we answer within one business day."
  description="Contact Oneward: request the free 30-day analysis, book a demo call, or email partners@getoneward.com."
>
  <section style="background: #ffffff; padding: 104px 64px;">
    <div class="two-col" style="max-width: 1160px; margin: 0 auto; display: grid; grid-template-columns: minmax(0, 400px) minmax(0, 1fr); gap: 80px; align-items: start;">
      <div style="display: flex; flex-direction: column; gap: 28px;">
        <div style="display: flex; flex-direction: column; gap: 14px;">
          <h2 style={h2}>Three ways in.</h2>
          <p style={body}>If you are deciding whether agents fit your HR stack, start with the analysis. If you want to see one running first, book the call. For anything else, email.</p>
        </div>
        <div style="display: flex; flex-direction: column;">
          {details.map(([k, v, href]) => (
            <div style="display: flex; align-items: baseline; justify-content: space-between; gap: 16px; padding: 12px 0; border-top: 1px solid #e3e1db;">
              <span style="font-size: 13.5px; color: #6f6a5e; white-space: nowrap;">{k}</span>
              <a href={href} target={href.startsWith('http') ? '_blank' : undefined} rel={href.startsWith('http') ? 'noopener' : undefined} style="font-family: 'IBM Plex Mono', monospace; font-size: 12.5px; color: #101828; text-decoration: none; border-bottom: 1px solid rgba(16,24,40,0.3); text-align: right;">{v}</a>
            </div>
          ))}
        </div>
      </div>
      <div style="display: flex; flex-direction: column;">
        {ways.map((w, i) => (
          <a
            href={w.href}
            class="contact-way"
            data-demo={w.demo ? '' : undefined}
            target={w.demo ? '_blank' : undefined}
            rel={w.demo ? 'noopener' : undefined}
            style={`display: grid; grid-template-columns: 44px minmax(0, 1fr); column-gap: 18px; align-items: start; padding: 28px 0; border-top: 1px solid #e3e1db; ${i === ways.length - 1 ? 'border-bottom: 1px solid #e3e1db;' : ''} text-decoration: none; color: inherit;`}
          >
            <span style="width: 44px; height: 44px; border-radius: 12px; background: #f7f6f3; border: 1px solid #e3e1db; display: flex; align-items: center; justify-content: center;"><Icon src={w.icon} size={19} color="#030FFF" /></span>
            <span style="display: flex; flex-direction: column; gap: 6px;">
              <span style="font-family: 'Sora', sans-serif; font-size: 19px; font-weight: 600; letter-spacing: -0.02em; line-height: 1.3; color: #101828;">{w.title}</span>
              <span style="font-size: 14.5px; line-height: 1.65; color: #4a463c; text-wrap: pretty;">{w.body}</span>
              <span class="contact-way-link" style="margin-top: 4px; font-size: 13.5px; color: #030FFF;">{w.link} →</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ What happens next ============ -->
  <section style="background: #f7f6f3; background-image: radial-gradient(rgba(3,15,255,0.14) 1px, transparent 1px); background-size: 24px 24px; background-position: 12px 12px; border-top: 1px solid #e3e1db; padding: 104px 64px;">
    <div style="max-width: 1160px; margin: 0 auto; display: flex; flex-direction: column; gap: 44px;">
      <div style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 14px; max-width: 720px; margin: 0 auto;">
        <h2 style={h2}>What happens after you write.</h2>
        <p style={body}>The same three steps, whichever route you take.</p>
      </div>
      <div class="stages-grid" style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px;">
        {next.map((n, i) => (
          <div style="display: flex; flex-direction: column; gap: 14px;">
            <div style="display: flex; align-items: center; gap: 12px;">
              <span style="width: 16px; display: flex; justify-content: center;">{i === 2 ? <DotMark size={16} /> : <span style="width: 7px; height: 7px; border-radius: 50%; background: #030FFF;"></span>}</span>
              <span style="flex: 1; height: 1px; background: #d9d6ce;"></span>
              <span style="font-family: 'IBM Plex Mono', monospace; font-size: 12px; color: #030FFF;">0{i + 1}</span>
            </div>
            <span style="font-family: 'Sora', sans-serif; font-size: 19px; font-weight: 600; letter-spacing: -0.02em; line-height: 1.3; color: #101828;">{n.title}</span>
            <span style="font-size: 14.5px; line-height: 1.65; color: #4a463c; text-wrap: pretty;">{n.body}</span>
          </div>
        ))}
      </div>
    </div>
  </section>
</PageShell>

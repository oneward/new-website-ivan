---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import UseCaseLibrary from '../components/UseCaseLibrary.astro';
import Cta from '../components/Cta.astro';
import Footer from '../components/Footer.astro';
---
<Base title="Use cases — Oneward" description="The Oneward agent library: AI agents for every stage of the employee lifecycle, running on one integrity foundation inside your HR tenant.">
  <div style="background: linear-gradient(160deg, #05071F 0%, #030FFF 100%); color: #ffffff; position: relative; overflow: hidden;">
    <div style="position: absolute; inset: 0; pointer-events: none; background-image: radial-gradient(rgba(255,255,255,0.15) 1.6px, transparent 1.6px); background-size: 48px 48px; background-position: 30px 20px; -webkit-mask-image: linear-gradient(215deg, #000 0%, rgba(0,0,0,0.45) 38%, transparent 70%); mask-image: linear-gradient(215deg, #000 0%, rgba(0,0,0,0.45) 38%, transparent 70%);"></div>
    <Nav sticky />
    <Nav />
    <div class="stub-hero library-hero" data-sticky-trigger style="position: relative; max-width: 1160px; margin: 0 auto; padding: 72px 64px 88px; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 16px;">
      <span style="font-family: 'IBM Plex Mono', monospace; font-size: 12px; letter-spacing: 0.18em; color: #2BD4FF;">AGENT LIBRARY</span>
      <h1 style="margin: 0; font-family: 'Sora', sans-serif; font-size: clamp(34px, 4vw, 48px); font-weight: 600; letter-spacing: -0.025em; line-height: 1.1; max-width: 760px;">Agents for every HR workflow.</h1>
      <p style="margin: 0; font-size: 15px; line-height: 1.7; color: rgba(255,255,255,0.78); max-width: 800px; text-wrap: pretty;">Each agent replaces a specific manual process in your HR stack. All of them run on one integrity foundation, one permission model, and one audit trail. Open any card to see the process it replaces and what changes.</p>
    </div>
  </div>
  <UseCaseLibrary />
  <Cta />
  <Footer />
  <script src="../scripts/main.js"></script>
</Base>

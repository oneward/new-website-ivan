---
// Shared layout for the legal and trust pages: compact dark header,
// one reading column, consistent typography via .legal-content.
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  intro: string;
  updated?: string;
  description?: string;
}
const { title, intro, updated, description } = Astro.props;
---
<Base title={`${title} — Oneward`} description={description ?? intro}>
  <div style="background: linear-gradient(160deg, #05071F 0%, #030FFF 100%); color: #ffffff; position: relative;">
    <div style="position: absolute; inset: 0; pointer-events: none; background-image: radial-gradient(rgba(255,255,255,0.15) 1.6px, transparent 1.6px); background-size: 48px 48px; background-position: 30px 20px; -webkit-mask-image: linear-gradient(215deg, #000 0%, rgba(0,0,0,0.45) 38%, transparent 70%); mask-image: linear-gradient(215deg, #000 0%, rgba(0,0,0,0.45) 38%, transparent 70%);"></div>
    <Nav sticky />
    <Nav />
    <div class="stub-hero library-hero" data-sticky-trigger style="position: relative; max-width: 1160px; margin: 0 auto; padding: 56px 64px 72px; display: flex; flex-direction: column; gap: 14px;">
      <h1 style="margin: 0; font-family: 'Sora', sans-serif; font-size: clamp(32px, 3.6vw, 44px); font-weight: 600; letter-spacing: -0.025em; line-height: 1.1; max-width: 760px; text-wrap: pretty;">{title}</h1>
      <p style="margin: 0; font-size: 15px; line-height: 1.7; color: rgba(255,255,255,0.78); max-width: 640px; text-wrap: pretty;">{intro}</p>
      {updated && <span style="font-size: 12.5px; color: rgba(255,255,255,0.55);">Last updated {updated}</span>}
    </div>
  </div>
  <section style="background: #ffffff; padding: 72px 64px 104px;">
    <div class="legal-content" style="max-width: 760px; margin: 0 auto;">
      <slot />
    </div>
  </section>
  <Footer />
  <script src="../scripts/main.js"></script>
</Base>

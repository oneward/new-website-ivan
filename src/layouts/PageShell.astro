---
// Shared shell for the company pages (About, Careers, Contact): dark hero
// with the site texture, page content, footer, and the shared scripts.
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  intro: string;
  description?: string;
  align?: 'left' | 'center';
}
const { title, intro, description, align = 'left' } = Astro.props;
const centered = align === 'center';
const texture = "position: absolute; inset: 0; pointer-events: none; background-image: radial-gradient(rgba(255,255,255,0.15) 1.6px, transparent 1.6px); background-size: 48px 48px; background-position: 30px 20px; -webkit-mask-image: linear-gradient(215deg, #000 0%, rgba(0,0,0,0.45) 38%, transparent 70%); mask-image: linear-gradient(215deg, #000 0%, rgba(0,0,0,0.45) 38%, transparent 70%);";
---
<Base title={`${title} — Oneward`} description={description ?? intro}>
  <div style="background: linear-gradient(160deg, #05071F 0%, #030FFF 100%); color: #ffffff; position: relative; overflow: hidden;">
    <div style={texture}></div>
    <Nav sticky />
    <Nav />
    <div class="page-hero library-hero" data-sticky-trigger style={`position: relative; max-width: 1160px; margin: 0 auto; padding: 72px 64px 88px; display: flex; flex-direction: column; gap: 16px; ${centered ? 'align-items: center; text-align: center;' : ''}`}>
      <h1 style="margin: 0; font-family: 'Sora', sans-serif; font-size: clamp(34px, 4vw, 48px); font-weight: 600; letter-spacing: -0.025em; line-height: 1.1; max-width: 760px; text-wrap: pretty;">{title}</h1>
      <p style="margin: 0; font-size: 15px; line-height: 1.7; color: rgba(255,255,255,0.78); max-width: 640px; text-wrap: pretty;">{intro}</p>
      <slot name="hero" />
    </div>
  </div>
  <slot />
  <Footer />
  <script src="../scripts/main.js"></script>
</Base>

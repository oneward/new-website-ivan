---
import '../styles/fonts.css';
import '../styles/global.css';
import DemoModal from '../components/DemoModal.astro';
import '../styles/responsive.css';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Oneward — AI agents for enterprise HR',
  description = 'Oneward is the AI-readiness layer on top of your HR systems. It turns HR requests into finished work, not open tickets.',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/assets/logo-mark.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <slot />
    <DemoModal />
  </body>
</html>

---
import '../styles/fonts.css';
import '../styles/global.css';
import DemoModal from '../components/DemoModal.astro';
import '../styles/responsive.css';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Oneward — AI agents for enterprise HR',
  description = 'Oneward is the AI-readiness layer on top of your HR systems. It turns HR requests into finished work, not open tickets.',
} = Astro.props;
---

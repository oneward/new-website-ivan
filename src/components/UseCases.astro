---
// Homepage teaser: three featured agents on dark cards with illustrated
// previews, plus one call to action to the full library.
import UseCaseCard from './UseCaseCard.astro';
import FeaturedPreview from './FeaturedPreview.astro';
import { useCases, featuredSlugs } from '../data/useCases';

const featured = featuredSlugs.map((slug) => useCases.find((u) => u.slug === slug)!);
---
<section id="agents" style="background: #f7f6f3; background-image: radial-gradient(rgba(3,15,255,0.14) 1px, transparent 1px); background-size: 24px 24px; background-position: 12px 12px; border-top: 1px solid #e3e1db; padding: 104px 64px;">
  <div style="max-width: 1160px; margin: 0 auto; display: flex; flex-direction: column; gap: 36px;">
    <div style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 10px; max-width: 880px; margin: 0 auto;">
      <h2 style="margin: 0; font-family: 'Sora', sans-serif; font-size: 32px; font-weight: 500; letter-spacing: -0.02em; line-height: 1.15;">Agents for every HR workflow.</h2>
      <p style="margin: 0; font-size: 14px; line-height: 1.7; color: #4a463c; white-space: nowrap;">Each replacing a specific manual process in your HR stack. All run on one integrity foundation, one permission model, and one audit trail.</p>
    </div>
    <div class="uc-grid" style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px;">
      {featured.map((u) => (
        <UseCaseCard u={u} href={`/use-cases#${u.slug}`} moreLabel="See how it works →" dark>
          <FeaturedPreview slot="preview" slug={u.slug} dark />
        </UseCaseCard>
      ))}
    </div>
    <div style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 20px; padding-top: 12px;">
      <span style="font-family: 'Sora', sans-serif; font-size: 20px; font-weight: 500; letter-spacing: -0.015em; color: #101828; text-wrap: pretty;">The full library covers the whole employee lifecycle.</span>
      <a href="/use-cases" class="btn-blue" style="font-size: 15px; padding: 14px 28px;">Explore the full library →</a>
    </div>
  </div>
</section>

---
import DotMark from './DotMark.astro';
import Icon from './Icon.astro';
import { useCases, roleOrder, catShort, rolesText } from '../data/useCases';
---
<section id="agents" style="background: #f7f6f3; border-top: 1px solid #e3e1db; padding: 104px 64px;">
  <div style="max-width: 1160px; margin: 0 auto; display: flex; flex-direction: column; gap: 36px;" data-usecases>
    <div style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 10px; max-width: 880px; margin: 0 auto;">
      <h2 style="margin: 0; font-family: 'Sora', sans-serif; font-size: 32px; font-weight: 500; letter-spacing: -0.02em; line-height: 1.15;">Agents for every HR workflow.</h2>
      <p style="margin: 0; font-size: 14px; line-height: 1.7; color: #4a463c; white-space: nowrap;">Each replacing a specific manual process in your HR stack. All run on one integrity foundation, one permission model, and one audit trail.</p>
    </div>
    <div style="display: flex; align-items: center; justify-content: center; gap: 8px; flex-wrap: wrap;">
      {roleOrder.map((r) => (
        <button type="button" class:list={['uc-filter', { 'is-current': r === 'All' }]} data-uc-filter={r} style="display: flex; align-items: center; gap: 8px; font-family: 'Inter', sans-serif; font-size: 13px; border-radius: 999px; padding: 9px 16px; white-space: nowrap; transition: all 0.25s;">{r === 'All' ? 'All roles' : r}<span class="uc-count" style="font-family: 'IBM Plex Mono', monospace; font-size: 10.5px;">{r === 'All' ? useCases.length : useCases.filter((u) => u.roles.includes(r)).length}</span></button>
      ))}
    </div>
    <div class="uc-grid" style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px;">
      {useCases.map((u) => (
        <div class="uc-card" data-uc-roles={u.roles.join('|')} style={`background: ${u.f ? '#f5f6ff' : '#ffffff'}; border: 1px solid ${u.f ? 'rgba(3,15,255,0.2)' : '#e3e1db'}; border-radius: 12px; padding: 20px 20px 18px; display: flex; flex-direction: column; gap: 14px; min-height: 100%; box-sizing: border-box;`}>
          <div style="display: flex; align-items: center; justify-content: space-between; gap: 10px;">
            <span style={`width: 36px; height: 36px; border-radius: 10px; background: ${u.f ? '#ffffff' : 'rgba(3,15,255,0.06)'}; display: flex; align-items: center; justify-content: center;`}><Icon src={`/assets/ph-${u.icon}.svg`} size={18} color="#030FFF" /></span>
            {u.f && <span style="display: flex; align-items: center; gap: 6px; font-size: 11px; color: #030FFF; background: #ffffff; border: 1px solid rgba(3,15,255,0.2); border-radius: 999px; padding: 4px 9px 4px 7px; white-space: nowrap;"><DotMark size={11} />Always on</span>}
          </div>
          <div style="display: flex; flex-direction: column; gap: 6px;">
            <span style={`font-family: 'IBM Plex Mono', monospace; font-size: 10px; letter-spacing: 0.14em; color: ${u.f ? '#030FFF' : '#9a968c'};`}>{catShort[u.cat] ?? u.cat}</span>
            <span style="font-family: 'Sora', sans-serif; font-size: 15px; font-weight: 500; letter-spacing: -0.01em; color: #101828;">{u.title}</span>
            <span style="font-size: 13px; line-height: 1.6; color: #6f6a5e; text-wrap: pretty;">{u.body}</span>
          </div>
          <div style={`margin-top: auto; padding-top: 12px; border-top: 1px solid ${u.f ? 'rgba(3,15,255,0.12)' : '#eceae4'}; display: flex; align-items: center; gap: 7px;`}><Icon src="/assets/00b81253.svg" size={13} color="#9a968c" /><span style="font-size: 12px; color: #6f6a5e;">{rolesText(u.roles)}</span></div>
        </div>
      ))}
    </div>
    <div style="display: flex; align-items: center; justify-content: center; gap: 10px; background: #ffffff; border: 1px solid #e3e1db; border-radius: 999px; padding: 12px 20px 12px 16px; align-self: center;">
      <DotMark size={16} /><span style="font-size: 13.5px; color: #4a463c;">The integrity foundation runs continuously beneath every agent above. It is what makes the rest safe to act.</span>
    </div>
  </div>
</section>

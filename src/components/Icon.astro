---
// Monochrome icon rendered via CSS mask so it can take any color.
interface Props {
  src: string;
  size: number;
  color?: string;
  style?: string;
}
const { src, size, color = '#101828', style = '' } = Astro.props;
---
<span style={`width: ${size}px; height: ${size}px; flex-shrink: 0; display: block; background: ${color}; -webkit-mask-image: url('${src}'); -webkit-mask-position: center; -webkit-mask-size: contain; -webkit-mask-repeat: no-repeat; mask-image: url('${src}'); mask-position: center; mask-size: contain; mask-repeat: no-repeat; ${style}`}></span>

---
// Booking modal: opened by any a[data-demo] link (see main.js); the link itself
// points at the Google booking page as the no-JS / new-tab fallback. The
// scheduler iframe is only loaded on first open.
---
<dialog class="demo-modal" data-demo-modal aria-labelledby="demo-modal-title">
  <div class="demo-modal-panel">
    <div style="display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 16px 20px; border-bottom: 1px solid #eceae4;">
      <div style="display: flex; flex-direction: column; gap: 2px; min-width: 0;">
        <span id="demo-modal-title" style="font-family: 'Sora', sans-serif; font-size: 17px; font-weight: 600; letter-spacing: -0.02em; color: #101828;">Book a demo call</span>
        <span style="font-size: 13px; color: #6f6a5e;">Thirty minutes. See the agents live, in the tools your teams already use.</span>
      </div>
      <button type="button" class="uc-modal-close" data-demo-close aria-label="Close">×</button>
    </div>
    <iframe
      title="Book a demo call with Oneward"
      data-src="https://calendar.google.com/calendar/appointments/schedules/AcZssZ1bEd8u8szmWjajGOsMk7zNeJJtUbpUer3K8dbyixL7u-72JTup49yQgVSRj_5RfjmI6AbF53Fi?gv=true"
      style="border: 0; display: block; width: 100%; flex: 1; min-height: 0;"
    ></iframe>
    <div style="padding: 10px 20px; border-top: 1px solid #eceae4; font-size: 12.5px; color: #6f6a5e; text-align: center;">Prefer email? <a href="mailto:partners@getoneward.com" style="color: #030FFF;">partners@getoneward.com</a></div>
  </div>
</dialog>

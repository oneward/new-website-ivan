---
// The Oneward dot mark, drawn as an animated field of 20 dots.
// Rendered at 230x230 and scaled down; `size` is the final rendered box in px.
interface Props {
  size: number;
  color?: string;
  animation?: 'think' | 'pulse' | 'none';
}
const { size, color = '#030FFF', animation = 'think' } = Astro.props;

const pts: [number, number][] = [[2,0],[4,0],[1,1],[3,1],[5,1],[0,2],[2,2],[4,2],[6,2],[1,3],[5,3],[0,4],[2,4],[4,4],[6,4],[1,5],[3,5],[5,5],[2,6],[4,6]];
const f = (n: number) => Number(n.toFixed(2));
const dots = pts.map(([u, v], i) => ({
  left: 9 + u * 30,
  top: 9 + v * 30,
  anim:
    animation === 'think' ? `owThink ${f(2.8 + (i * 5) % 7 * 0.36)}s ease-in-out ${f(-((i * 11.7) % 6.8))}s infinite`
    : animation === 'pulse' ? `owCoverPulse 9s ease-in-out ${f(((i * 11.7) % 1) * 1.1)}s infinite`
    : 'none',
}));
const scale = size / 230;
---
<div style={`width: ${size}px; height: ${size}px; flex-shrink: 0;`}>
  <div style={`position: relative; width: 230px; height: 230px; transform: scale(${scale}); transform-origin: top left;`}>
    {dots.map((d) => (
      <div style={`position: absolute; left: ${d.left}px; top: ${d.top}px; width: 32px; height: 32px; border-radius: 50%; background: ${color}; animation: ${d.anim};`}></div>
    ))}
  </div>
</div>

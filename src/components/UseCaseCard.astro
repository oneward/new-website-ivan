---
import DotMark from './DotMark.astro';
import Icon from './Icon.astro';
import { catShort, rolesText, type UseCase } from '../data/useCases';

// One card of the use-case grid. On the homepage it links to the library;
// in the library it opens the detail modal (data-uc-* feeds main.js).
interface Props {
  u: UseCase;
  href?: string;
  clickable?: boolean;
  moreLabel?: string;
}
const { u, href, clickable = false, moreLabel = 'Details →' } = Astro.props;
// Foundation agents (u.f) get the blue-tinted treatment.
const c = { bg: u.f ? '#f5f6ff' : '#ffffff', border: u.f ? 'rgba(3,15,255,0.2)' : '#e3e1db', tile: u.f ? '#ffffff' : 'rgba(3,15,255,0.06)', icon: '#030FFF', cat: u.f ? '#030FFF' : '#9a968c', title: '#101828', body: '#6f6a5e', rule: u.f ? 'rgba(3,15,255,0.12)' : '#eceae4', roles: '#6f6a5e', rolesIcon: '#9a968c', more: '#030FFF' };
const Tag = href ? 'a' : 'div';
const detail = clickable
  ? {
      'data-uc-slug': u.slug,
      'data-uc-title': u.title,
      'data-uc-cat': catShort[u.cat] ?? u.cat,
      'data-uc-users': u.users,
      'data-uc-legacy': u.legacy,
      'data-uc-solution': u.solution,
      'data-uc-icon': u.icon,
      'data-uc-foundation': String(!!u.f),
      role: 'button',
      tabindex: 0,
    }
  : {};
---
<Tag
  class:list={['uc-card', { 'is-clickable': clickable || !!href }]}
  href={href}
  data-uc-roles={u.roles.join('|')}
  {...detail}
  style={`background: ${c.bg}; border: 1px solid ${c.border}; border-radius: 12px; padding: 20px 20px 18px; display: flex; flex-direction: column; gap: 14px; min-height: 100%; box-sizing: border-box;`}
>
  <slot name="preview" />
  <div style="display: flex; align-items: center; justify-content: space-between; gap: 10px;">
    <span style={`width: 36px; height: 36px; border-radius: 10px; background: ${c.tile}; display: flex; align-items: center; justify-content: center;`}><Icon src={`/assets/ph-${u.icon}.svg`} size={18} color={c.icon} /></span>
    {u.f && <span style="display: flex; align-items: center; gap: 6px; font-size: 11px; color: #030FFF; background: #ffffff; border: 1px solid rgba(3,15,255,0.2); border-radius: 999px; padding: 4px 9px 4px 7px; white-space: nowrap;"><DotMark size={11} />Always on</span>}
  </div>
  <div style="display: flex; flex-direction: column; gap: 6px;">
    <span style={`font-family: 'IBM Plex Mono', monospace; font-size: 10px; letter-spacing: 0.14em; color: ${c.cat};`}>{catShort[u.cat] ?? u.cat}</span>
    <span style={`font-family: 'Sora', sans-serif; font-size: 15px; font-weight: 500; letter-spacing: -0.01em; color: ${c.title};`}>{u.title}</span>
    <span style={`font-size: 13px; line-height: 1.6; color: ${c.body}; text-wrap: pretty;`}>{u.body}</span>
  </div>
  <div style={`margin-top: auto; padding-top: 12px; border-top: 1px solid ${c.rule}; display: flex; align-items: center; justify-content: space-between; gap: 10px;`}>
    <span style="display: flex; align-items: center; gap: 7px; min-width: 0;"><Icon src="/assets/00b81253.svg" size={13} color={c.rolesIcon} /><span style={`font-size: 12px; color: ${c.roles};`}>{rolesText(u.roles)}</span></span>
    {(clickable || href) && <span class="uc-card-more" style={`font-size: 12px; color: ${c.more}; white-space: nowrap;`}>{moreLabel}</span>}
  </div>
</Tag>

---
import DotMark from './DotMark.astro';
import Icon from './Icon.astro';

// The architecture diagram: drawn on a fixed 1032x552 canvas and scaled down
// responsively by main.js (data-diagram-wrap / data-diagram). Shown in the hero
// card (the nav's Integration landscape link points there).

const systems = [
  { left: 174, width: 100, icon: '/assets/9f881469.svg', color: '#4F63E6', label: 'HRIS' },
  { left: 282, width: 100, icon: '/assets/eeb3e36e.svg', color: '#3F8F7A', label: 'Payroll' },
  { left: 390, width: 130, icon: '/assets/52476a0e.svg', color: '#7C6BC9', label: 'Time Tracking' },
  { left: 528, width: 100, icon: '/assets/59ff3fef.svg', color: '#B0637A', label: 'Benefits' },
  { left: 636, width: 100, icon: '/assets/ph-graduation-cap.svg', color: '#C08A3E', label: 'LMS' },
  { left: 744, width: 114, icon: '/assets/4df326ea.svg', color: '#5A7F9E', label: 'PEO' },
];
const systemDrops = [223, 331, 454, 577, 685, 800];
const hcms = ['Workday', 'SAP SuccessFactors', 'Oracle HCM'];
const channels = [
  { icon: '/assets/7c8b1612.svg', color: '#7A4E8C', label: 'Slack' },
  { icon: '/assets/423a9853.svg', color: '#4F5FB8', label: 'Microsoft Teams' },
  { icon: '/assets/8de6010d.svg', color: '#3F8F7A', label: 'WhatsApp' },
  { icon: '/assets/63f4974e.svg', color: '#C0762F', label: 'Your portal (widget)' },
];
const lifecycle = ['Attract', 'Onboard', 'Grow', 'Move', 'Offboard'];
const lifecycleDrops = [213, 316, 416, 515, 616, 716, 817];
const spawns = [
  { x: 316, stemH: 12, y: 488, delay: 0, label: 'Screen applicants' },
  { x: 416, stemH: 40, y: 516, delay: 1.6, label: 'Enroll payroll' },
  { x: 516, stemH: 12, y: 488, delay: 3.2, label: 'Assign training' },
  { x: 616, stemH: 40, y: 516, delay: 4.8, label: 'Update org chart' },
  { x: 716, stemH: 12, y: 488, delay: 6.4, label: 'Close out payroll' },
];
// Styles for the phone-only stacked version (same data, one column).
const node = 'display: flex; align-items: center; gap: 6px; height: 36px; padding: 0 7px; box-sizing: border-box; background: #ffffff; border: 1px solid #e3e1db; border-radius: 8px; font-size: 12px; color: #101828; white-space: nowrap;';
const stem = 'width: 2px; height: 22px; border-left: 2px dotted rgba(3,15,255,0.35); position: relative;';
const stemDot = 'position: absolute; left: -1.5px; top: 0; width: 3px; height: 3px; margin-top: -1.5px; border-radius: 50%; background: #030FFF; animation: owFlowY 2.4s linear infinite;';
const pill = 'height: 30px; padding: 0 12px; display: flex; align-items: center; white-space: nowrap; background: #ffffff; border-radius: 999px; font-size: 11.5px; font-weight: 500;';
const caption = "font-family: 'IBM Plex Mono', monospace; font-size: 8.5px; letter-spacing: 0.1em; color: #9a968c; text-align: center; white-space: nowrap;";
const group = 'flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: center; gap: 8px; padding: 10px 8px; border: 1.5px dashed rgba(3,15,255,0.25); border-radius: 12px; box-sizing: border-box;';
const pillStyle = 'position: absolute; height: 32px; padding: 0 14px; display: flex; align-items: center; white-space: nowrap; background: #ffffff; border-radius: 999px; font-size: 11.5px; font-weight: 500;';
---
<div class="diagram-scroll diagram-canvas" style="width: 100%;">
<div style="width: 100%; overflow: hidden; display: flex; justify-content: center; height: 552px;" data-diagram-wrap>
  <div style="position: relative; width: 1032px; height: 552px; flex-shrink: 0; transform-origin: top center;" data-diagram>
    <div style="position: absolute; left: 16px; top: 147px; width: 236px; height: 168px; border: 1.5px dashed rgba(3,15,255,0.25); border-radius: 12px; box-sizing: border-box;"></div>
    <div style="position: absolute; left: 224px; top: 64px; width: 577px; height: 2px; border-top: 2px dotted rgba(3,15,255,0.35);"></div>
    {systemDrops.map((x) => (
      <div style={`position: absolute; left: ${x}px; top: 40px; width: 2px; height: 24px; border-left: 2px dotted rgba(3,15,255,0.35);`}></div>
    ))}
    {systems.map((s) => (
      <div style={`position: absolute; left: ${s.left}px; top: 0px; width: ${s.width}px; height: 40px; display: flex; align-items: center; justify-content: center; gap: 7px; background: #ffffff; border: 1px solid #e3e1db; border-radius: 8px; font-size: 13px; color: #101828;`}><Icon src={s.icon} size={14} color={s.color} style="display: inline-block;" />{s.label}</div>
    ))}
    {hcms.map((h, i) => (
      <div style={`position: absolute; left: 32px; top: ${163 + i * 48}px; width: 204px; height: 40px; display: flex; align-items: center; gap: 10px; padding: 0 16px; box-sizing: border-box; background: #ffffff; border: 1px solid #e3e1db; border-radius: 8px; font-size: 13px; color: #101828;`}>{h}</div>
    ))}
    <div style="position: absolute; left: 515px; top: 64px; width: 2px; height: 120px; border-left: 2px dotted rgba(3,15,255,0.35);"><span style="position: absolute; left: -1.5px; top: 0; width: 3px; height: 3px; margin-top: -1.5px; border-radius: 50%; background: #030FFF; animation: owFlowY 3.6s linear 0s infinite;"></span></div>
    <div style={`${pillStyle} left: 516px; top: 92px; transform: translateX(-50%); color: #030FFF; border: 1px solid rgba(3,15,255,0.35);`}>Governed connection</div>
    <div style="position: absolute; left: 468px; top: 184px; width: 96px; height: 96px; border-radius: 16px; background: linear-gradient(160deg, #030FFF 0%, #020865 100%); display: flex; align-items: center; justify-content: center; box-shadow: 0 16px 36px rgba(2,7,31,0.25);">
      <DotMark size={52} color="#ffffff" />
    </div>
    <div style="position: absolute; left: 252px; top: 231px; width: 216px; height: 2px; border-top: 2px dotted rgba(3,15,255,0.35);"><span style="position: absolute; top: -1.5px; left: 0; width: 3px; height: 3px; margin-left: -1.5px; border-radius: 50%; background: #030FFF; animation: owFlowX 3.2s linear 1.1s infinite;"></span></div>
    <div style={`${pillStyle} left: 360px; top: 216px; transform: translateX(-50%); color: #020865; border: 1px solid rgba(2,8,101,0.35);`}>Your tenant</div>
    <div style="position: absolute; left: 564px; top: 231px; width: 216px; height: 2px; border-top: 2px dotted rgba(3,15,255,0.35);"><span style="position: absolute; top: -1.5px; left: 0; width: 3px; height: 3px; margin-left: -1.5px; border-radius: 50%; background: #030FFF; animation: owFlowX 4.2s linear 0.6s infinite;"></span></div>
    <div style={`${pillStyle} left: 672px; top: 216px; transform: translateX(-50%); color: #020865; border: 1px solid rgba(2,8,101,0.35);`}>Requests &amp; approvals</div>
    <div style="position: absolute; left: 780px; top: 123px; width: 236px; height: 216px; border: 1.5px dashed rgba(3,15,255,0.25); border-radius: 12px; box-sizing: border-box;"></div>
    {channels.map((c, i) => (
      <div style={`position: absolute; left: 796px; top: ${139 + i * 48}px; width: 204px; height: 40px; display: flex; align-items: center; gap: 10px; padding: 0 16px; box-sizing: border-box; background: #ffffff; border: 1px solid #e3e1db; border-radius: 8px; font-size: 13px; color: #101828;`}><Icon src={c.icon} size={15} color={c.color} />{c.label}</div>
    ))}
    <span style="position: absolute; left: 780px; top: 347px; width: 236px; text-align: center; font-family: 'IBM Plex Mono', monospace; font-size: 10px; letter-spacing: 0.14em; color: #9a968c;">EMPLOYEES · MANAGERS · HR</span>
    <span style="position: absolute; left: 16px; top: 323px; width: 236px; text-align: center; font-family: 'IBM Plex Mono', monospace; font-size: 10px; letter-spacing: 0.14em; color: #9a968c;">YOUR HR SYSTEMS</span>
    <div style="position: absolute; left: 515px; top: 280px; width: 2px; height: 60px; border-left: 2px dotted rgba(3,15,255,0.35);"><span style="position: absolute; left: -1.5px; top: 0; width: 3px; height: 3px; margin-top: -1.5px; border-radius: 50%; background: #030FFF; animation: owFlowY 2.4s linear 1.8s infinite;"></span></div>
    <div style={`${pillStyle} left: 516px; top: 344px; transform: translateX(-50%); color: #030FFF; border: 1px solid rgba(3,15,255,0.35);`}>Agents</div>
    <div style="position: absolute; left: 515px; top: 380px; width: 2px; height: 28px; border-left: 2px dotted rgba(3,15,255,0.35);"><span style="position: absolute; left: -1.5px; top: 0; width: 3px; height: 3px; margin-top: -1.5px; border-radius: 50%; background: #030FFF; animation: owFlowY 1.8s linear 2.6s infinite;"></span></div>
    <div style="position: absolute; left: 214px; top: 408px; width: 604px; height: 2px; border-top: 2px dotted rgba(3,15,255,0.35);"></div>
    {lifecycleDrops.map((x) => (
      <div style={`position: absolute; left: ${x}px; top: 408px; width: 2px; height: 24px; border-left: 2px dotted rgba(3,15,255,0.35);`}></div>
    ))}
    {lifecycle.map((l, i) => (
      <div style={`position: absolute; left: ${268 + i * 100}px; top: 432px; width: 96px; height: 40px; display: flex; align-items: center; justify-content: center; background: #ffffff; border: 1px solid #e3e1db; border-radius: 8px; font-size: 13px; color: #101828;`}>{l}</div>
    ))}
    <div style="position: absolute; left: 168px; top: 432px; width: 92px; height: 40px; border: 1.5px dashed rgba(3,15,255,0.25); border-radius: 8px; box-sizing: border-box;"></div>
    <div style="position: absolute; left: 772px; top: 432px; width: 92px; height: 40px; border: 1.5px dashed rgba(3,15,255,0.25); border-radius: 8px; box-sizing: border-box;"></div>
    {spawns.map((s) => (
      <>
        <div style={`position: absolute; left: ${s.x - 1}px; top: 472px; width: 2px; height: ${s.stemH}px; border-left: 2px dotted rgba(3,15,255,0.35);`}></div>
        <div style={`position: absolute; left: ${s.x}px; top: ${s.y}px; transform: translateX(-50%); display: flex; align-items: center; white-space: nowrap;`}>
          <span style={`display: block; animation: owSpawnMark 12s ease-out ${s.delay}s infinite;`}><DotMark size={14} /></span>
          <span style={`display: block; overflow: hidden; max-width: 0; animation: owSpawnText 12s ease-in-out ${s.delay}s infinite;`}><span style="display: block; padding-left: 6px; font-size: 11px; background: linear-gradient(90deg, #9a968c 35%, #101828 50%, #9a968c 65%); background-size: 200% 100%; -webkit-background-clip: text; background-clip: text; color: transparent; animation: owShimmer 2.4s linear infinite;">{s.label}</span></span>
        </div>
      </>
    ))}
  </div>
</div>
</div>

<!-- Phone version: the same nodes in one column. Shown below 760px, see responsive.css. -->
<div class="diagram-stack" style="display: none; flex-direction: column; align-items: center; width: 100%; max-width: 420px; margin: 0 auto;">
  <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; max-width: 340px;">
    {systems.map((s) => (
      <div style={node}><Icon src={s.icon} size={14} color={s.color} style="display: inline-block;" />{s.label}</div>
    ))}
  </div>
  <div style={stem}><span style={stemDot}></span></div>
  <div style={`${pill} color: #030FFF; border: 1px solid rgba(3,15,255,0.35);`}>Governed connection</div>
  <div style={stem}><span style={stemDot}></span></div>
  <div style="width: 72px; height: 72px; border-radius: 14px; background: linear-gradient(160deg, #030FFF 0%, #020865 100%); display: flex; align-items: center; justify-content: center; box-shadow: 0 16px 36px rgba(2,7,31,0.25);">
    <DotMark size={40} color="#ffffff" />
  </div>
  <div style={stem}></div>
  <div style="width: 100%; position: relative; height: 22px;">
    <div style="position: absolute; left: 25%; right: 25%; top: 0; border-top: 2px dotted rgba(3,15,255,0.35);"></div>
    <div style="position: absolute; left: 25%; top: 0; width: 2px; height: 22px; border-left: 2px dotted rgba(3,15,255,0.35); margin-left: -1px;"></div>
    <div style="position: absolute; left: 75%; top: 0; width: 2px; height: 22px; border-left: 2px dotted rgba(3,15,255,0.35); margin-left: -1px;"></div>
  </div>
  <div style="width: 100%; display: flex; gap: 10px; align-items: stretch;">
    <div style="flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 8px;">
      <div style={`${pill} color: #020865; border: 1px solid rgba(2,8,101,0.35);`}>Your tenant</div>
      <div style={`${group} width: 100%;`}>
        {hcms.map((h) => <div style={`${node} justify-content: center; padding: 0 8px; font-size: 12px;`}>{h}</div>)}
      </div>
      <span style={caption}>YOUR HR SYSTEMS</span>
    </div>
    <div style="flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 8px;">
      <div style={`${pill} color: #020865; border: 1px solid rgba(2,8,101,0.35);`}>Requests &amp; approvals</div>
      <div style={`${group} width: 100%;`}>
        {channels.map((c) => <div style={`${node} padding: 0 8px; font-size: 12px;`}><Icon src={c.icon} size={14} color={c.color} />{c.label.replace(' (widget)', '')}</div>)}
      </div>
      <span style={caption}>EMPLOYEES · MANAGERS · HR</span>
    </div>
  </div>
  <div style={`${stem} height: 26px;`}><span style={stemDot}></span></div>
  <div style={`${pill} color: #030FFF; border: 1px solid rgba(3,15,255,0.35);`}>Agents</div>
  <div style={stem}><span style={stemDot}></span></div>
  <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 6px;">
    {lifecycle.map((l) => <div style={`${node} justify-content: center;`}>{l}</div>)}
  </div>
  <div style="display: flex; flex-wrap: wrap; justify-content: center; align-content: flex-start; gap: 4px 14px; margin-top: 12px; height: 44px;">
    {spawns.map((s) => (
      <div style="display: flex; align-items: center; white-space: nowrap;">
        <span style={`display: block; animation: owSpawnMark 12s ease-out ${s.delay}s infinite;`}><DotMark size={14} /></span>
        <span style={`display: block; overflow: hidden; max-width: 0; animation: owSpawnText 12s ease-in-out ${s.delay}s infinite;`}><span style="display: block; padding-left: 6px; font-size: 11px; background: linear-gradient(90deg, #9a968c 35%, #101828 50%, #9a968c 65%); background-size: 200% 100%; -webkit-background-clip: text; background-clip: text; color: transparent; animation: owShimmer 2.4s linear infinite;">{s.label}</span></span>
      </div>
    ))}
  </div>
</div>

---
import DotMark from './DotMark.astro';
---
<section id="contact" style="background: linear-gradient(160deg, #030FFF 0%, #020865 100%); padding: 112px 64px; position: relative; overflow: hidden; color: #ffffff;">
  <div style="position: absolute; inset: 0; pointer-events: none; background-image: radial-gradient(rgba(255,255,255,0.15) 1.6px, transparent 1.6px); background-size: 48px 48px; background-position: 30px 20px; -webkit-mask-image: linear-gradient(215deg, #000 0%, rgba(0,0,0,0.45) 38%, transparent 70%); mask-image: linear-gradient(215deg, #000 0%, rgba(0,0,0,0.45) 38%, transparent 70%);"></div>
  <div style="position: relative; display: flex; flex-direction: column; align-items: center; gap: 28px; text-align: center;">
    <DotMark size={72} color="#ffffff" animation="pulse" />
    <div style="display: flex; flex-direction: column; align-items: center; gap: 12px;">
      <h2 style="margin: 0; font-family: 'Sora', sans-serif; font-size: 40px; font-weight: 500; letter-spacing: -0.025em; line-height: 1.1; max-width: 760px; text-wrap: pretty;">Know where agents fit before you commit.</h2>
      <p style="margin: 0; font-size: 15px; line-height: 1.7; color: rgba(255,255,255,0.78); max-width: 620px; text-wrap: pretty;">A free 30-day analysis of your HR systems and workflows, and a written plan you keep, whatever you decide next.</p>
    </div>
    <div style="display: flex; align-items: center; justify-content: center; gap: 14px; flex-wrap: wrap;">
      <a href="/30-day-analysis" class="btn-primary" style="font-size: 15px; padding: 14px 30px;">Start your free 30-day analysis</a>
      <a href="https://calendar.google.com/calendar/appointments/schedules/AcZssZ1bEd8u8szmWjajGOsMk7zNeJJtUbpUer3K8dbyixL7u-72JTup49yQgVSRj_5RfjmI6AbF53Fi?gv=true" target="_blank" rel="noopener" data-demo class="btn-ghost" style="font-size: 15px; padding: 13px 28px;">Book a demo call</a>
    </div>
  </div>
</section>

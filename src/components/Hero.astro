---
import Nav from './Nav.astro';
import IntegrationDiagram from './IntegrationDiagram.astro';
import { tenants } from '../data/stages';
---
<section id="top" style="background: linear-gradient(160deg, #05071F 0%, #030FFF 100%); color: #ffffff; position: relative; overflow: hidden;">
  <div style="position: absolute; inset: 0; pointer-events: none; background-image: radial-gradient(rgba(255,255,255,0.15) 1.6px, transparent 1.6px); background-size: 48px 48px; background-position: 30px 20px; -webkit-mask-image: linear-gradient(215deg, #000 0%, rgba(0,0,0,0.45) 38%, transparent 70%); mask-image: linear-gradient(215deg, #000 0%, rgba(0,0,0,0.45) 38%, transparent 70%);"></div>
  <Nav sticky />
  <Nav />
  <div class="hero-inner" style="position: relative; max-width: 1160px; margin: 0 auto; padding: 84px 64px 128px; display: flex; flex-direction: column; align-items: center; gap: 20px;">
    <div style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 26px;">
      <span style="font-family: 'IBM Plex Mono', monospace; font-size: 12px; letter-spacing: 0.18em; color: #2BD4FF;">AI AGENTS FOR ENTERPRISE HR</span>
      <h1 style="margin: 0; font-family: 'Sora', sans-serif; font-size: clamp(38px, 4vw, 52px); font-weight: 600; letter-spacing: -0.025em; line-height: 1.1; max-width: 800px; min-height: 2.2em; display: flex; flex-direction: column; justify-content: center;">
        <span style="white-space: nowrap;">The AI-readiness layer</span>
        <span style="white-space: nowrap;">on top of <span data-tenant-word style="display: inline-block; white-space: nowrap;"><span style="color: #2BD4FF;">{tenants[0]}</span>.</span></span>
      </h1>
      <p style="margin: -8px 0 0; font-size: 16px; line-height: 1.6; color: rgba(255,255,255,0.78); white-space: nowrap;">Oneward turns HR requests into finished work, not open tickets.</p>
      <div style="display: flex; align-items: center; justify-content: center; gap: 14px; flex-wrap: wrap;">
        <a href="/30-day-analysis" class="btn-primary" style="font-size: 15px; padding: 14px 30px;">Start your free 30-day analysis</a>
        <a href="https://calendar.google.com/calendar/appointments/schedules/AcZssZ1bEd8u8szmWjajGOsMk7zNeJJtUbpUer3K8dbyixL7u-72JTup49yQgVSRj_5RfjmI6AbF53Fi?gv=true" target="_blank" rel="noopener" data-demo class="btn-ghost" style="font-size: 15px; padding: 13px 28px;">Book a demo call</a>
      </div>
    </div>
    <div id="integrations" style="display: flex; flex-direction: column; align-items: center; gap: 12px; width: 100%; margin-top: 56px; scroll-margin-top: 80px;" data-hero-card>
      <div style="width: 100%; background: #f7f6f3; background-image: radial-gradient(rgba(3,15,255,0.14) 1px, transparent 1px); background-size: 24px 24px; background-position: 12px 12px; border-radius: 12px; padding: 36px 16px 20px; box-sizing: border-box; box-shadow: 0 24px 50px rgba(2,7,31,0.45); display: flex; flex-direction: column; gap: 28px;">
        <div style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 10px; max-width: 900px; margin: 0 auto;">
          <h2 class="hero-card-title" style="margin: 0; font-family: 'Sora', sans-serif; font-size: 20px; font-weight: 500; letter-spacing: -0.02em; line-height: 1.15; color: #030FFF; text-wrap: balance;">Oneward sits on top of the systems you already run.</h2>
          <p style="margin: 0; font-size: 14px; line-height: 1.7; color: #4a463c; text-wrap: pretty;">The layer between your HR systems and the people who need to act. Works with any HCM or HRIS, no new system of record.</p>
        </div>
        <IntegrationDiagram />
      </div>
    </div>
  </div>
</section>
